@page
@model LoginModel
@{
    ViewData["Title"] = "Login";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <div class="h-1 w-16 rounded-full mx-auto mb-6" style="background: #22D3EE; box-shadow: 0 0 15px #22D3EE;"></div>
            <h2 class="text-3xl font-bold text-soft-white">
                Sign in to your account
            </h2>
            <p class="mt-3 text-graphite">
                Don't have an account?
                <a href="/signup" class="text-cyan hover:underline">Sign up for free</a>
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 p-4 rounded-lg" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444;">
                @Model.ErrorMessage
            </div>
        }

        <div class="card">
            <form class="space-y-6" method="post">
                @Html.AntiForgeryToken()

                <div>
                    <label for="ApiKey" class="block text-sm font-medium text-soft-white mb-2">API Key</label>
                    <input id="ApiKey" type="text" required asp-for="ApiKey"
                        class="w-full px-4 py-3 rounded-lg text-soft-white placeholder-graphite focus:outline-none focus:ring-2 focus:ring-cyan"
                        style="background: #0B0F1A; border: 1px solid #374151;"
                        placeholder="sm_live_...">
                    <p class="mt-2 text-xs text-graphite">
                        Your API key was provided when you signed up. Check your dashboard or email.
                    </p>
                </div>

                <div class="flex items-center">
                    <input id="RememberMe" type="checkbox" asp-for="RememberMe"
                        class="h-4 w-4 rounded focus:ring-2 focus:ring-cyan"
                        style="background: #0B0F1A; border: 1px solid #374151;">
                    <label for="RememberMe" class="ml-2 text-sm text-graphite">Remember me for 7 days</label>
                </div>

                <button type="submit" class="btn-primary w-full py-3 rounded-xl font-semibold text-lg">
                    Sign In
                </button>
            </form>
        </div>

        <div class="mt-8 text-center">
            <p class="text-graphite text-sm mb-4">
                SerialMemory uses API key authentication for security.
            </p>
            <div class="p-4 rounded-lg" style="background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2);">
                <p class="text-cyan text-sm">
                    Lost your API key? <a href="/signup" class="underline">Create a new account</a> or check your original signup email.
                </p>
            </div>
        </div>
    </div>
</div>
