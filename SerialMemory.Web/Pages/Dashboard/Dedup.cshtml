@page "/dashboard/dedup"
@model SerialMemory.Web.Pages.Dashboard.DedupModel
@{
    ViewData["Title"] = "Dedup & Supersede";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white">Dedup & Supersede</h1>
        <p class="mt-2 text-graphite">Track duplicate detection, memory superseding, and merge operations.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Dupes Detected</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Stats?.DupesDetected ?? 0)</div>
            <div class="text-xs text-graphite mt-1">Last 30d</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Skipped</div>
            <div class="mt-1 text-2xl font-semibold text-yellow-400">@(Model.Stats?.DupesSkipped ?? 0)</div>
            <div class="text-xs text-graphite mt-1">dedup=skip</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Appended</div>
            <div class="mt-1 text-2xl font-semibold text-blue-400">@(Model.Stats?.DupesAppended ?? 0)</div>
            <div class="text-xs text-graphite mt-1">dedup=append</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Warned</div>
            <div class="mt-1 text-2xl font-semibold text-orange-400">@(Model.Stats?.DupesWarned ?? 0)</div>
            <div class="text-xs text-graphite mt-1">dedup=warn</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Superseded</div>
            <div class="mt-1 text-2xl font-semibold text-purple-400">@(Model.Stats?.SupersedeCount ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Merged</div>
            <div class="mt-1 text-2xl font-semibold text-green-400">@(Model.Stats?.MergeCount ?? 0)</div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mb-6 border-b border-slate">
        <nav class="-mb-px flex space-x-8" id="dedupTabs">
            <button onclick="showTab('supersede')" class="tab-btn active border-b-2 border-electric py-2 px-1 text-sm font-medium text-electric" data-tab="supersede">
                Supersede History (@Model.SupersedeHistory.Count)
            </button>
            <button onclick="showTab('merges')" class="tab-btn border-b-2 border-transparent py-2 px-1 text-sm font-medium text-graphite hover:text-soft-white" data-tab="merges">
                Merge History (@Model.MergeHistory.Count)
            </button>
        </nav>
    </div>

    <!-- Supersede History Tab -->
    <div id="tab-supersede" class="tab-content">
        <div class="space-y-4">
            @foreach (var item in Model.SupersedeHistory)
            {
                <div class="card border-l-4 border-purple-500">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-1 text-xs rounded bg-purple-600 text-white">Superseded</span>
                            @if (!string.IsNullOrEmpty(item.Reason))
                            {
                                <span class="text-sm text-graphite">@item.Reason</span>
                            }
                        </div>
                        <span class="text-xs text-graphite">@item.SupersededAt.ToString("MMM dd HH:mm")</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="bg-red-900/20 rounded-md p-3">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs text-red-400 font-semibold">OLD (invalidated)</span>
                                <span class="text-xs text-graphite font-mono">@item.OldMemoryId.ToString()[..12]...</span>
                            </div>
                            <div class="text-sm text-soft-white">@(item.OldContentPreview ?? "(content unavailable)")</div>
                        </div>
                        <div class="bg-green-900/20 rounded-md p-3">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-xs text-green-400 font-semibold">NEW (active)</span>
                                <span class="text-xs text-graphite font-mono">@(item.NewMemoryId?.ToString()[..12] ?? "???")...</span>
                            </div>
                            <div class="text-sm text-soft-white">@(item.NewContentPreview ?? "(content unavailable)")</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(item.ActorId))
                    {
                        <div class="mt-2 text-xs text-graphite">Actor: @item.ActorId</div>
                    }
                </div>
            }
            @if (Model.SupersedeHistory.Count == 0)
            {
                <div class="card text-center text-graphite py-8">
                    No supersede operations recorded yet.
                </div>
            }
        </div>
    </div>

    <!-- Merge History Tab -->
    <div id="tab-merges" class="tab-content hidden">
        <div class="space-y-4">
            @foreach (var item in Model.MergeHistory)
            {
                <div class="card border-l-4 border-green-500">
                    <div class="flex justify-between items-start mb-3">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-1 text-xs rounded bg-green-600 text-white">Merged</span>
                            @if (!string.IsNullOrEmpty(item.Strategy))
                            {
                                <span class="text-sm text-graphite">Strategy: @item.Strategy</span>
                            }
                        </div>
                        <span class="text-xs text-graphite">@item.MergedAt.ToString("MMM dd HH:mm")</span>
                    </div>

                    <div class="bg-slate/30 rounded-md p-3">
                        <div class="text-xs text-graphite mb-1 font-mono">@item.MergedMemoryId.ToString()[..12]...</div>
                        <div class="text-sm text-soft-white">@(item.ContentPreview ?? "(content unavailable)")</div>
                    </div>

                    @if (!string.IsNullOrEmpty(item.ActorId))
                    {
                        <div class="mt-2 text-xs text-graphite">Actor: @item.ActorId</div>
                    }
                </div>
            }
            @if (Model.MergeHistory.Count == 0)
            {
                <div class="card text-center text-graphite py-8">
                    No merge operations recorded yet.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function showTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('active', 'border-electric', 'text-electric');
            el.classList.add('border-transparent', 'text-graphite');
        });

        document.getElementById('tab-' + tabName).classList.remove('hidden');
        const activeBtn = document.querySelector(`[data-tab="${tabName}"]`);
        activeBtn.classList.add('active', 'border-electric', 'text-electric');
        activeBtn.classList.remove('border-transparent', 'text-graphite');
    }
</script>
}
