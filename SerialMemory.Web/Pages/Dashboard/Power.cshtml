@page "/dashboard/power"
@model SerialMemory.Web.Pages.Dashboard.PowerModel
@{
    ViewData["Title"] = "Power Mode";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white flex items-center gap-3">
            <svg class="w-8 h-8 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            Power Mode
        </h1>
        <p class="mt-2 text-graphite">Direct memory manipulation. Use with caution.</p>
    </div>

    <div class="mb-6 bg-red-900/30 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
        <strong>Warning:</strong> Actions in Power Mode are irreversible and bypass normal validation. Double-check before confirming any operation.
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Memory Browser -->
        <div class="lg:col-span-1">
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Load Memory</h3>
                <form method="post" asp-page-handler="LoadMemory" class="mb-4">
                    @Html.AntiForgeryToken()
                    <div class="flex gap-2">
                        <input type="text" name="MemoryId" placeholder="Memory ID (GUID)"
                               class="flex-1 bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm font-mono focus:outline-none focus:border-electric">
                        <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">Load</button>
                    </div>
                </form>

                <h4 class="text-sm font-semibold text-graphite mb-2">Recent Memories</h4>
                <div class="space-y-2 max-h-[500px] overflow-y-auto">
                    @foreach (var mem in Model.RecentMemories)
                    {
                        <a href="/dashboard/power?id=@mem.Id"
                           class="block bg-slate/30 hover:bg-slate/50 rounded-md p-2 transition">
                            <div class="flex justify-between items-start mb-1">
                                <span class="text-xs font-mono text-graphite">@mem.Id.ToString()[..8]...</span>
                                <span class="text-xs @(mem.IsActive ? "text-green-400" : "text-red-400")">
                                    @(mem.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            <div class="text-sm text-soft-white line-clamp-2">@mem.Content</div>
                            <div class="flex justify-between mt-1 text-xs text-graphite">
                                <span>@mem.Layer</span>
                                <span>@((mem.Confidence * 100).ToString("F0"))%</span>
                            </div>
                        </a>
                    }
                    @if (Model.RecentMemories.Count == 0)
                    {
                        <div class="text-center text-graphite py-4">No memories found</div>
                    }
                </div>
            </div>
        </div>

        <!-- Center Column: Memory Editor -->
        <div class="lg:col-span-2 space-y-6">
            @if (Model.SelectedMemory != null)
            {
                <div class="card">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-lg font-semibold text-soft-white">Memory Details</h3>
                        <span class="text-xs font-mono text-graphite">@Model.SelectedMemory.Id</span>
                    </div>

                    <!-- Memory Info Grid -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                        <div>
                            <div class="text-xs text-graphite">Layer</div>
                            <div class="text-sm text-soft-white">@Model.SelectedMemory.Layer</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Confidence</div>
                            <div class="text-sm text-cyan">@((Model.SelectedMemory.Confidence * 100).ToString("F1"))%</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Half-Life</div>
                            <div class="text-sm text-soft-white">@Model.SelectedMemory.HalfLifeDays days</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Status</div>
                            <div class="text-sm @(Model.SelectedMemory.IsActive ? "text-green-400" : "text-red-400")">
                                @(Model.SelectedMemory.IsActive ? "Active" : "Inactive")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Created</div>
                            <div class="text-sm text-soft-white">@Model.SelectedMemory.CreatedAt.ToString("g")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Last Reinforced</div>
                            <div class="text-sm text-soft-white">@(Model.SelectedMemory.LastReinforcedAt?.ToString("g") ?? "Never")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Source</div>
                            <div class="text-sm text-soft-white">@(Model.SelectedMemory.Source ?? "Unknown")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Hash</div>
                            <div class="text-sm text-soft-white font-mono truncate" title="@Model.SelectedMemory.ContentHash">
                                @(Model.SelectedMemory.ContentHash?[..16] ?? "N/A")...
                            </div>
                        </div>
                    </div>

                    @if (Model.SelectedMemory.Entities.Count > 0)
                    {
                        <div class="mb-4">
                            <div class="text-xs text-graphite mb-2">Linked Entities</div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var ent in Model.SelectedMemory.Entities)
                                {
                                    <span class="bg-slate px-2 py-1 rounded text-xs text-soft-white">
                                        @ent.Name <span class="text-graphite">(@ent.Type)</span>
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Content Editor -->
                    <form method="post" asp-page-handler="UpdateContent">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MemoryId" value="@Model.SelectedMemory.Id" />
                        <div class="mb-4">
                            <label class="block text-sm font-medium text-graphite mb-2">Content</label>
                            <textarea name="NewContent" rows="6"
                                      class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric font-mono">@Model.SelectedMemory.Content</textarea>
                        </div>
                        <div class="flex gap-3">
                            <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                                Update Content
                            </button>
                        </div>
                    </form>

                    <!-- Danger Zone -->
                    <div class="mt-6 pt-6 border-t border-slate">
                        <h4 class="text-sm font-semibold text-red-400 mb-3">Danger Zone</h4>
                        <form method="post" asp-page-handler="DeleteMemory" onsubmit="return confirm('Are you sure you want to delete this memory? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="MemoryId" value="@Model.SelectedMemory.Id" />
                            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                                Delete Memory
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="card">
                    <div class="text-center py-8 text-graphite">
                        Select a memory from the list or enter a memory ID to begin editing.
                    </div>
                </div>
            }

            <!-- Batch Operations -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Batch Operations</h3>
                <form method="post" asp-page-handler="BatchAction" onsubmit="return confirm('Are you sure you want to perform this batch action?');">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-graphite mb-2">Memory IDs (one per line or comma-separated)</label>
                        <textarea name="BatchMemoryIds" rows="4" placeholder="Enter memory IDs..."
                                  class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric font-mono"></textarea>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-graphite mb-2">Action</label>
                        <select name="BatchAction" class="bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric">
                            <option value="delete">Delete All</option>
                            <option value="decay">Apply Decay</option>
                            <option value="reinforce">Reinforce All</option>
                            <option value="archive">Archive All</option>
                            <option value="merge">Merge Into One</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-medium text-graphite mb-2">Merged Content (for merge action only)</label>
                        <textarea name="MergedContent" rows="3" placeholder="Combined content for merged memory..."
                                  class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric"></textarea>
                    </div>
                    <button type="submit" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                        Execute Batch Action
                    </button>
                </form>
            </div>

            <!-- System Operations -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">System Operations</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <form method="post" asp-page-handler="ForceReembed" onsubmit="return confirm('This will re-embed all memories. Continue?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-md text-sm font-medium transition">
                            Force Re-embed All Memories
                        </button>
                        <p class="text-xs text-graphite mt-1">Regenerate embeddings for all memories</p>
                    </form>
                    <form method="post" asp-page-handler="RecrawlEntities" onsubmit="return confirm('This will recrawl all entity relationships. Continue?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white px-4 py-3 rounded-md text-sm font-medium transition">
                            Recrawl Entity Relationships
                        </button>
                        <p class="text-xs text-graphite mt-1">Extract entities from existing memories</p>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
