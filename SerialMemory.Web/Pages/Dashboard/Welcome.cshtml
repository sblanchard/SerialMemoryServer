@page "/dashboard/welcome"
@model SerialMemory.Web.Pages.Dashboard.WelcomeModel
@{
    ViewData["Title"] = "Welcome to SerialMemory";
}

<div class="min-h-screen bg-gradient-to-br from-indigo-50 via-white to-purple-50 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Welcome Header -->
        <div class="text-center mb-12">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-indigo-500 to-purple-600 rounded-full mb-6 shadow-lg">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h1 class="text-4xl font-bold text-soft-white mb-4">Welcome to SerialMemory!</h1>
            <p class="text-xl text-graphite">Your AI memory infrastructure is ready</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ApiKey))
        {
            <!-- API Key Section -->
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden mb-8">
                <div class="bg-gradient-to-r from-yellow-50 to-amber-50 border-b border-yellow-100 px-6 py-4">
                    <div class="flex items-center gap-3">
                        <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                        </svg>
                        <span class="font-semibold text-yellow-300">This API key will only be shown once. Save it now!</span>
                    </div>
                </div>
                <div class="p-6">
                    <label class="block text-sm font-medium text-soft-white mb-2">Your API Key</label>
                    <div class="flex items-center gap-3">
                        <code id="apiKey" class="flex-1 bg-gray-900 text-green-400 px-4 py-3 rounded-lg font-mono text-sm break-all select-all">@Model.ApiKey</code>
                        <button onclick="copyToClipboard('apiKey', this)"
                            class="flex-shrink-0 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-lg text-sm font-medium transition-colors flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                            </svg>
                            Copy Key
                        </button>
                    </div>
                </div>
            </div>

            <!-- Quick Start Steps -->
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden mb-8">
                <div class="px-6 py-4 border-b border-gray-100">
                    <h2 class="text-xl font-semibold text-soft-white">Quick Start</h2>
                </div>
                <div class="divide-y divide-gray-100">
                    <!-- Step 1: Docker -->
                    <div class="p-6">
                        <div class="flex items-start gap-4">
                            <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                                <span class="text-indigo-600 font-bold">1</span>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-semibold text-soft-white mb-2">Run the Docker MCP Client</h3>
                                <p class="text-graphite text-sm mb-4">Start the SerialMemory MCP server locally:</p>
                                <div class="relative">
                                    <pre id="dockerCommand" class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono">@Model.DockerCommand</pre>
                                    <button onclick="copyToClipboard('dockerCommand', this)"
                                        class="absolute top-2 right-2 bg-gray-700 hover:bg-gray-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">
                                        Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Claude Desktop Config -->
                    <div class="p-6">
                        <div class="flex items-start gap-4">
                            <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 rounded-full flex items-center justify-center">
                                <span class="text-indigo-600 font-bold">2</span>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-semibold text-soft-white mb-2">Configure Claude Desktop</h3>
                                <p class="text-graphite text-sm mb-4">Add this to your <code class="bg-slate/50 px-1.5 py-0.5 rounded text-xs">claude_desktop_config.json</code>:</p>
                                <div class="relative">
                                    <pre id="mcpConfig" class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm font-mono">@Model.McpConfig</pre>
                                    <button onclick="copyToClipboard('mcpConfig', this)"
                                        class="absolute top-2 right-2 bg-gray-700 hover:bg-gray-600 text-white px-3 py-1.5 rounded text-xs font-medium transition-colors">
                                        Copy
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Start Using -->
                    <div class="p-6">
                        <div class="flex items-start gap-4">
                            <div class="flex-shrink-0 w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div class="flex-1">
                                <h3 class="font-semibold text-soft-white mb-2">Start Using Memory</h3>
                                <p class="text-graphite text-sm">
                                    Claude will now have access to persistent memory across sessions.
                                    Your memories are stored securely and isolated to your tenant.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- No key available (already viewed) -->
            <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-8 text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-slate/50 rounded-full mb-6">
                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                    </svg>
                </div>
                <h2 class="text-xl font-semibold text-soft-white mb-2">API Key Already Viewed</h2>
                <p class="text-graphite mb-6">
                    Your API key was displayed when you first signed up. For security, it can only be shown once.
                    If you need a new key, you can regenerate one below.
                </p>
                <form method="post" asp-page-handler="Regenerate">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white px-6 py-3 rounded-lg text-sm font-medium transition-colors"
                        onclick="return confirm('This will revoke your current API key and generate a new one. Continue?')">
                        Regenerate API Key
                    </button>
                </form>
            </div>
        }

        <!-- Next Steps -->
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100">
                <h2 class="text-xl font-semibold text-soft-white">Next Steps</h2>
            </div>
            <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
                <a href="/dashboard" class="flex items-center gap-4 p-4 rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition-colors">
                    <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="font-medium text-soft-white">Dashboard</div>
                        <div class="text-sm text-graphite">View your memories</div>
                    </div>
                </a>
                <a href="/dashboard/api-keys" class="flex items-center gap-4 p-4 rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition-colors">
                    <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="font-medium text-soft-white">API Keys</div>
                        <div class="text-sm text-graphite">Manage your keys</div>
                    </div>
                </a>
                <a href="https://docs.serialmemory.com" target="_blank" class="flex items-center gap-4 p-4 rounded-lg border border-gray-200 hover:border-indigo-300 hover:bg-indigo-50 transition-colors">
                    <div class="w-10 h-10 bg-indigo-100 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="font-medium text-soft-white">Documentation</div>
                        <div class="text-sm text-graphite">Learn more</div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function copyToClipboard(elementId, button) {
        const element = document.getElementById(elementId);
        const text = element.innerText || element.textContent;
        navigator.clipboard.writeText(text).then(() => {
            const originalText = button.innerHTML;
            button.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Copied!';
            button.classList.add('bg-green-600');
            button.classList.remove('bg-indigo-600', 'bg-gray-700');
            setTimeout(() => {
                button.innerHTML = originalText;
                button.classList.remove('bg-green-600');
                if (elementId === 'apiKey') {
                    button.classList.add('bg-indigo-600');
                } else {
                    button.classList.add('bg-gray-700');
                }
            }, 2000);
        });
    }
</script>
}
