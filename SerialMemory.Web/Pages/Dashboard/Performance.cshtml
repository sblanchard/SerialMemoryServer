@page "/dashboard/performance"
@model SerialMemory.Web.Pages.Dashboard.PerformanceModel
@{
    ViewData["Title"] = "Performance";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">Performance</h1>
            <p class="mt-2 text-graphite">Real-time system metrics and latency analysis.</p>
        </div>
        <form method="post" asp-page-handler="ResetMetrics" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                Reset Metrics
            </button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <!-- Metrics Snapshot -->
    <div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Requests</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Metrics?.TotalRequests.ToString("N0") ?? "—")</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Errors</div>
            <div class="mt-1 text-2xl font-semibold @(Model.Metrics?.TotalErrors > 0 ? "text-red-400" : "text-green-400")">
                @(Model.Metrics?.TotalErrors.ToString("N0") ?? "—")
            </div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Avg Latency</div>
            <div class="mt-1 text-2xl font-semibold text-cyan">@(Model.Metrics?.AvgLatencyMs.ToString("F1") ?? "—") ms</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">P95 Latency</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Metrics?.P95LatencyMs.ToString("F1") ?? "—") ms</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">P99 Latency</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Metrics?.P99LatencyMs.ToString("F1") ?? "—") ms</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Req/sec</div>
            <div class="mt-1 text-2xl font-semibold text-electric">@(Model.Metrics?.RequestsPerSecond.ToString("F2") ?? "—")</div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Latency Table -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Operation Latencies</h3>
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead>
                        <tr class="border-b border-slate">
                            <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Operation</th>
                            <th class="px-3 py-2 text-right text-xs font-medium text-graphite uppercase">Avg</th>
                            <th class="px-3 py-2 text-right text-xs font-medium text-graphite uppercase">P95</th>
                            <th class="px-3 py-2 text-right text-xs font-medium text-graphite uppercase">P99</th>
                            <th class="px-3 py-2 text-right text-xs font-medium text-graphite uppercase">Count</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate">
                        @foreach (var item in Model.LatencyTable)
                        {
                            <tr class="hover:bg-slate/30">
                                <td class="px-3 py-2 text-sm text-soft-white font-mono">@item.Operation</td>
                                <td class="px-3 py-2 text-sm text-right @(item.AvgMs > 500 ? "text-red-400" : item.AvgMs > 200 ? "text-yellow-400" : "text-green-400")">
                                    @item.AvgMs.ToString("F1") ms
                                </td>
                                <td class="px-3 py-2 text-sm text-right text-soft-white">@item.P95Ms.ToString("F1") ms</td>
                                <td class="px-3 py-2 text-sm text-right text-soft-white">@item.P99Ms.ToString("F1") ms</td>
                                <td class="px-3 py-2 text-sm text-right text-graphite">@item.Count.ToString("N0")</td>
                            </tr>
                        }
                        @if (Model.LatencyTable.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-3 py-4 text-center text-graphite">No latency data available</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Slow Operations Log -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Slow Operations (Last 20)</h3>
            <div class="space-y-2 max-h-80 overflow-y-auto">
                @foreach (var slow in Model.SlowOps)
                {
                    <div class="bg-slate/30 rounded-md p-3">
                        <div class="flex justify-between items-start">
                            <span class="text-sm font-mono text-soft-white">@slow.Operation</span>
                            <span class="text-sm font-semibold @(slow.DurationMs > 1000 ? "text-red-400" : "text-yellow-400")">
                                @slow.DurationMs.ToString("F0") ms
                            </span>
                        </div>
                        <div class="text-xs text-graphite mt-1">@slow.Timestamp.ToString("HH:mm:ss")</div>
                        @if (!string.IsNullOrEmpty(slow.Details))
                        {
                            <div class="text-xs text-graphite mt-1 truncate">@slow.Details</div>
                        }
                    </div>
                }
                @if (Model.SlowOps.Count == 0)
                {
                    <div class="text-center text-graphite py-4">No slow operations recorded</div>
                }
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Cache Stats -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Cache Stats</h3>
            @if (Model.Cache != null)
            {
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-graphite">Hit Rate</span>
                        <span class="text-cyan font-semibold">@((Model.Cache.HitRate * 100).ToString("F1"))%</span>
                    </div>
                    <div class="w-full bg-slate rounded-full h-2">
                        <div class="bg-cyan h-2 rounded-full" style="width: @((Model.Cache.HitRate * 100))%"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-4">
                        <div>
                            <div class="text-xs text-graphite">Hits</div>
                            <div class="text-lg font-semibold text-green-400">@Model.Cache.Hits.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Misses</div>
                            <div class="text-lg font-semibold text-red-400">@Model.Cache.Misses.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Items</div>
                            <div class="text-lg font-semibold text-soft-white">@Model.Cache.ItemCount.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Evictions</div>
                            <div class="text-lg font-semibold text-yellow-400">@Model.Cache.Evictions.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="text-xs text-graphite">Memory Usage</div>
                        <div class="text-sm text-soft-white">@((Model.Cache.MemoryBytes / 1024.0 / 1024.0).ToString("F2")) MB</div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-graphite py-4">Cache stats unavailable</div>
            }
        </div>

        <!-- DB Pool Stats -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">DB Connection Pool</h3>
            @if (Model.DbPool != null)
            {
                <div class="space-y-3">
                    <div class="flex justify-between">
                        <span class="text-graphite">Pool Usage</span>
                        <span class="text-soft-white font-semibold">
                            @Model.DbPool.ActiveConnections / @Model.DbPool.MaxConnections
                        </span>
                    </div>
                    <div class="w-full bg-slate rounded-full h-2">
                        <div class="@(Model.DbPool.ActiveConnections > Model.DbPool.MaxConnections * 0.8 ? "bg-red-400" : "bg-electric") h-2 rounded-full"
                             style="width: @((Model.DbPool.ActiveConnections * 100.0 / Math.Max(1, Model.DbPool.MaxConnections)))%"></div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-4">
                        <div>
                            <div class="text-xs text-graphite">Active</div>
                            <div class="text-lg font-semibold text-electric">@Model.DbPool.ActiveConnections</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Idle</div>
                            <div class="text-lg font-semibold text-green-400">@Model.DbPool.IdleConnections</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Acquired</div>
                            <div class="text-lg font-semibold text-soft-white">@Model.DbPool.TotalAcquired.ToString("N0")</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Released</div>
                            <div class="text-lg font-semibold text-soft-white">@Model.DbPool.TotalReleased.ToString("N0")</div>
                        </div>
                    </div>
                    <div class="mt-2">
                        <div class="text-xs text-graphite">Avg Acquire Time</div>
                        <div class="text-sm text-soft-white">@Model.DbPool.AvgAcquireTimeMs.ToString("F2") ms</div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center text-graphite py-4">DB pool stats unavailable</div>
            }
        </div>

        <!-- Active Requests -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Active Requests</h3>
            <div class="space-y-2 max-h-64 overflow-y-auto">
                @foreach (var req in Model.ActiveRequests)
                {
                    <div class="bg-slate/30 rounded-md p-2">
                        <div class="flex justify-between items-start">
                            <span class="text-sm font-mono text-soft-white truncate max-w-[150px]">@req.Operation</span>
                            <span class="text-sm font-semibold @(req.ElapsedMs > 5000 ? "text-red-400" : req.ElapsedMs > 1000 ? "text-yellow-400" : "text-green-400")">
                                @req.ElapsedMs.ToString("F0") ms
                            </span>
                        </div>
                        <div class="text-xs text-graphite mt-1 font-mono truncate">@req.RequestId</div>
                    </div>
                }
                @if (Model.ActiveRequests.Count == 0)
                {
                    <div class="text-center text-graphite py-4">No active requests</div>
                }
            </div>
        </div>
    </div>

    <!-- Set Threshold Form -->
    <div class="card">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Configure Alert Threshold</h3>
        <form method="post" asp-page-handler="SetThreshold" class="flex flex-wrap gap-4 items-end">
            @Html.AntiForgeryToken()
            <div>
                <label for="operation" class="block text-sm font-medium text-graphite mb-1">Operation</label>
                <input type="text" name="operation" id="operation" required
                       class="bg-slate border border-slate rounded-md px-3 py-2 text-soft-white focus:outline-none focus:border-electric"
                       placeholder="e.g., memory_search">
            </div>
            <div>
                <label for="thresholdMs" class="block text-sm font-medium text-graphite mb-1">Threshold (ms)</label>
                <input type="number" name="thresholdMs" id="thresholdMs" required min="1"
                       class="bg-slate border border-slate rounded-md px-3 py-2 text-soft-white focus:outline-none focus:border-electric w-32"
                       placeholder="500">
            </div>
            <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                Set Threshold
            </button>
        </form>
    </div>
</div>
