@page "/dashboard/api-keys"
@model SerialMemory.Web.Pages.Dashboard.ApiKeysModel
@{
    ViewData["Title"] = "API Keys";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">API Keys</h1>
            <p class="mt-2 text-graphite">Manage API keys for accessing the SerialMemory API and MCP server.</p>
        </div>
        <button onclick="showCreateModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">
            Create New Key
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-900/30 border border-green-500/50 text-green-700 px-4 py-3 rounded mb-6">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
            @Model.ErrorMessage
        </div>
    }

    <!-- API Keys List -->
    <div class="card">
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-graphite uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-graphite uppercase tracking-wider">Key Prefix</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-graphite uppercase tracking-wider">Created</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-graphite uppercase tracking-wider">Last Used</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-graphite uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-graphite uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-700">
                @if (Model.ApiKeys.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="px-6 py-4 text-center text-graphite">
                            No API keys found. Create one to get started.
                        </td>
                    </tr>
                }
                @foreach (var key in Model.ApiKeys)
                {
                    <tr>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="text-sm font-medium text-soft-white">@key.Name</div>
                            <div class="text-sm text-graphite">@key.Description</div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <div class="flex items-center gap-2">
                                <code class="text-sm bg-slate/50 px-2 py-1 rounded">@key.KeyPrefix...</code>
                                <button onclick="copyToClipboard('@key.KeyPrefix')"
                                    class="text-graphite hover:text-soft-white" title="Copy prefix">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-graphite">
                            @key.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-graphite">
                            @(key.LastUsedAt?.ToString("MMM dd, yyyy") ?? "Never")
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            @if (key.IsRevoked)
                            {
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Revoked</span>
                            }
                            else if (key.ExpiresAt.HasValue && key.ExpiresAt < DateTimeOffset.UtcNow)
                            {
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-300">Expired</span>
                            }
                            else
                            {
                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-300">Active</span>
                            }
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-3">
                            @if (!key.IsRevoked)
                            {
                                <form method="post" asp-page-handler="Rotate" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyId" value="@key.Id" />
                                    <button type="submit" class="text-indigo-400 hover:text-indigo-300"
                                        onclick="return confirm('This will generate a new API key and revoke the current one. Continue?')">
                                        Rotate
                                    </button>
                                </form>
                                <form method="post" asp-page-handler="Revoke" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="keyId" value="@key.Id" />
                                    <button type="submit" class="text-red-600 hover:text-red-900"
                                        onclick="return confirm('Are you sure you want to revoke this API key? This cannot be undone.')">
                                        Revoke
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- MCP Configuration -->
    <div class="card mt-8">
        <h3 class="text-lg font-semibold mb-4">MCP Configuration</h3>
        <p class="text-graphite mb-4">Add this to your Claude Desktop <code>claude_desktop_config.json</code>:</p>
        <pre class="bg-gray-900 text-gray-100 p-4 rounded-lg overflow-x-auto text-sm"><code>{
  "mcpServers": {
    "serialmemory": {
      "command": "npx",
      "args": ["-y", "@@serialmemory/mcp-server"],
      "env": {
        "SERIALMEMORY_API_KEY": "@(Model.ApiKeys.FirstOrDefault()?.KeyPrefix ?? "YOUR_API_KEY")..."
      }
    }
  }
}</code></pre>
    </div>

    <!-- ChatGPT OAuth Integration -->
    <div class="card mt-8">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h3 class="text-lg font-semibold">ChatGPT OAuth Integration</h3>
                <p class="text-graphite text-sm mt-1">Enable OAuth to connect SerialMemory with ChatGPT custom GPTs.</p>
            </div>
        </div>

        <div class="space-y-4">
            <!-- OAuth Setup Instructions -->
            <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
                <h4 class="font-medium text-soft-white mb-2">Setup Instructions</h4>
                <ol class="list-decimal list-inside text-graphite text-sm space-y-2">
                    <li>Create or select an API key from above</li>
                    <li>Click "Enable OAuth" to generate OAuth credentials</li>
                    <li>In ChatGPT's GPT Builder, go to Configure → Actions → Authentication</li>
                    <li>Select "OAuth" and enter your credentials:
                        <ul class="list-disc list-inside ml-4 mt-1">
                            <li><strong>Client ID:</strong> Your API key prefix (shown below)</li>
                            <li><strong>Client Secret:</strong> Generated when you enable OAuth</li>
                            <li><strong>Authorization URL:</strong> <code class="bg-gray-900 px-1 rounded">https://api.serialmemory.dev/oauth/authorize</code></li>
                            <li><strong>Token URL:</strong> <code class="bg-gray-900 px-1 rounded">https://api.serialmemory.dev/oauth/token</code></li>
                            <li><strong>Scope:</strong> <code class="bg-gray-900 px-1 rounded">serialmemory.core</code></li>
                        </ul>
                    </li>
                    <li>Add the MCP endpoint: <code class="bg-gray-900 px-1 rounded">https://mcp.serialmemory.dev/mcp</code></li>
                </ol>
            </div>

            <!-- OAuth Keys List -->
            @foreach (var key in Model.ApiKeys.Where(k => !k.IsRevoked))
            {
                <div class="bg-gray-800 rounded-lg p-4 border border-gray-700">
                    <div class="flex justify-between items-start">
                        <div>
                            <h4 class="font-medium text-soft-white">@key.Name</h4>
                            <p class="text-graphite text-sm">Client ID: <code class="bg-gray-900 px-1 rounded">@key.KeyPrefix</code></p>
                        </div>
                        <div class="flex gap-2">
                            <form method="post" asp-page-handler="EnableOAuth" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="keyId" value="@key.Id" />
                                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-3 py-1 rounded text-sm"
                                    onclick="return confirm('Enable OAuth for this API key? This will generate a client secret.')">
                                    Enable OAuth
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- OAuth Credentials Modal -->
@if (!string.IsNullOrEmpty(Model.OAuthClientSecret))
{
    <div id="oauthModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-slate rounded-lg shadow-xl max-w-lg w-full mx-4 border border-gray-700">
            <div class="px-6 py-4 border-b border-gray-700">
                <h3 class="text-lg font-semibold text-green-400">OAuth Credentials Generated!</h3>
            </div>
            <div class="px-6 py-4">
                <div class="bg-yellow-900/30 border border-yellow-500/50 text-yellow-300 px-4 py-3 rounded mb-4">
                    <strong>Important:</strong> Copy the Client Secret now. You won't be able to see it again!
                </div>
                <div class="space-y-3">
                    <div>
                        <label class="block text-sm font-medium text-graphite mb-1">Client ID:</label>
                        <code id="oauthClientId" class="block bg-gray-900 text-soft-white px-3 py-2 rounded font-mono text-sm select-all">@Model.OAuthClientId</code>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-graphite mb-1">Client Secret:</label>
                        <div class="flex items-center gap-2">
                            <code id="oauthClientSecret" class="flex-1 bg-gray-900 text-green-400 px-3 py-2 rounded font-mono text-sm break-all select-all">@Model.OAuthClientSecret</code>
                            <button onclick="copyOAuthSecret()" class="bg-gray-700 hover:bg-gray-600 px-3 py-2 rounded text-sm text-soft-white">
                                Copy
                            </button>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-graphite mb-1">Token URL:</label>
                        <code class="block bg-gray-900 text-soft-white px-3 py-2 rounded font-mono text-sm select-all">https://api.serialmemory.dev/oauth/token</code>
                    </div>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-700 flex justify-end">
                <a href="/dashboard/api-keys" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md">Done</a>
            </div>
        </div>
    </div>
}

<!-- Create Key Modal -->
<div id="createModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 hidden items-center justify-center z-50">
    <div class="bg-slate rounded-lg shadow-xl max-w-md w-full mx-4 border border-gray-700">
        <form method="post" asp-page-handler="Create">
            @Html.AntiForgeryToken()
            <div class="px-6 py-4 border-b border-gray-700">
                <h3 class="text-lg font-semibold text-soft-white">Create API Key</h3>
            </div>
            <div class="px-6 py-4 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-soft-white mb-1">Name</label>
                    <input type="text" name="name" required
                        class="w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-soft-white focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                        placeholder="Production Key">
                </div>
                <div>
                    <label class="block text-sm font-medium text-soft-white mb-1">Description (optional)</label>
                    <input type="text" name="description"
                        class="w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-soft-white focus:outline-none focus:ring-indigo-500 focus:border-indigo-500"
                        placeholder="Used for...">
                </div>
                <div>
                    <label class="block text-sm font-medium text-soft-white mb-1">Expires (optional)</label>
                    <select name="expiresIn" class="w-full px-3 py-2 border border-gray-600 rounded-md bg-gray-800 text-soft-white focus:outline-none focus:ring-indigo-500 focus:border-indigo-500">
                        <option value="">Never</option>
                        <option value="30">30 days</option>
                        <option value="90">90 days</option>
                        <option value="365">1 year</option>
                    </select>
                </div>
            </div>
            <div class="px-6 py-4 border-t border-gray-700 flex justify-end gap-3">
                <button type="button" onclick="hideCreateModal()" class="px-4 py-2 text-graphite hover:text-soft-white">Cancel</button>
                <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md">Create Key</button>
            </div>
        </form>
    </div>
</div>

<!-- New Key Modal -->
@if (!string.IsNullOrEmpty(Model.NewApiKey))
{
    <div id="newKeyModal" class="fixed inset-0 bg-gray-600 bg-opacity-50 flex items-center justify-center z-50">
        <div class="bg-white rounded-lg shadow-xl max-w-lg w-full mx-4">
            <div class="px-6 py-4 border-b">
                <h3 class="text-lg font-semibold text-green-600">API Key Created!</h3>
            </div>
            <div class="px-6 py-4">
                <div class="bg-yellow-900/30 border border-yellow-500/50 text-yellow-300 px-4 py-3 rounded mb-4">
                    <strong>Important:</strong> Copy this key now. You won't be able to see it again!
                </div>
                <label class="block text-sm font-medium text-soft-white mb-2">Your new API key:</label>
                <div class="flex items-center gap-2">
                    <code class="flex-1 bg-gray-900 text-green-400 px-3 py-2 rounded font-mono text-sm break-all select-all">@Model.NewApiKey</code>
                    <button onclick="copyToClipboard('@Model.NewApiKey')" class="bg-slate hover:bg-gray-300 px-3 py-2 rounded text-sm">
                        Copy
                    </button>
                </div>
            </div>
            <div class="px-6 py-4 border-t flex justify-end">
                <a href="/dashboard/api-keys" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md">Done</a>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    function showCreateModal() {
        document.getElementById('createModal').classList.remove('hidden');
        document.getElementById('createModal').classList.add('flex');
    }

    function hideCreateModal() {
        document.getElementById('createModal').classList.add('hidden');
        document.getElementById('createModal').classList.remove('flex');
    }

    function copyToClipboard(text) {
        navigator.clipboard.writeText(text);
        alert('Copied to clipboard!');
    }

    function copyOAuthSecret() {
        const secret = document.getElementById('oauthClientSecret').textContent;
        navigator.clipboard.writeText(secret);
        alert('Client Secret copied to clipboard!');
    }
</script>
}
