@page "/dashboard/confidence"
@model SerialMemory.Web.Pages.Dashboard.ConfidenceModel
@{
    ViewData["Title"] = "Model Confidence";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white">Model Confidence</h1>
        <p class="mt-2 text-graphite">Multi-model reasoning confidence and disagreement analysis.</p>
    </div>

    @if (Model.IsSampleData)
    {
        <div class="mb-6 bg-blue-900/30 border border-blue-500/30 text-blue-300 px-4 py-3 rounded-lg">
            <div class="flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span><strong>Sample Data:</strong> Run multi-model reasoning to see real confidence scores.</span>
            </div>
        </div>
    }

    <!-- Summary Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <!-- Overall Confidence -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-graphite text-sm">Overall Confidence</p>
                    <p class="text-3xl font-bold text-soft-white">@((Model.CurrentConfidence * 100).ToString("F0"))%</p>
                </div>
                <div class="w-16 h-16 rounded-full flex items-center justify-center @(Model.CurrentConfidence >= 0.8 ? "bg-green-900/300/20" : Model.CurrentConfidence >= 0.6 ? "bg-yellow-900/300/20" : "bg-red-500/20")">
                    <svg class="w-8 h-8 @(Model.CurrentConfidence >= 0.8 ? "text-green-400" : Model.CurrentConfidence >= 0.6 ? "text-yellow-400" : "text-red-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
            </div>
            <div class="mt-2 w-full h-2 bg-midnight rounded-full overflow-hidden">
                <div class="h-full @(Model.CurrentConfidence >= 0.8 ? "bg-green-900/300" : Model.CurrentConfidence >= 0.6 ? "bg-yellow-900/300" : "bg-red-500") rounded-full transition-all duration-500" style="width: @((Model.CurrentConfidence * 100).ToString("F0"))%"></div>
            </div>
        </div>

        <!-- Total Runs -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-graphite text-sm">Reasoning Runs</p>
                    <p class="text-3xl font-bold text-soft-white">@Model.TotalRuns</p>
                </div>
                <div class="w-16 h-16 rounded-full bg-cyan/20 flex items-center justify-center">
                    <svg class="w-8 h-8 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Avg Disagreement -->
        <div class="card">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-graphite text-sm">Avg Disagreement</p>
                    <p class="text-3xl font-bold text-soft-white">@((Model.AvgDisagreement * 100).ToString("F0"))%</p>
                </div>
                <div class="w-16 h-16 rounded-full @(Model.AvgDisagreement <= 0.2 ? "bg-green-900/300/20" : Model.AvgDisagreement <= 0.4 ? "bg-yellow-900/300/20" : "bg-red-500/20") flex items-center justify-center">
                    <svg class="w-8 h-8 @(Model.AvgDisagreement <= 0.2 ? "text-green-400" : Model.AvgDisagreement <= 0.4 ? "text-yellow-400" : "text-red-400")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                </div>
            </div>
        </div>

        <!-- Run Reasoning Button -->
        <div class="card flex items-center justify-center">
            <form method="post" asp-page-handler="RunReasoning">
                <button type="submit" class="btn-primary px-6 py-3 rounded-lg font-medium flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Run Analysis
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Confidence History Chart -->
        <div class="card">
            <h2 class="text-lg font-semibold text-soft-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                </svg>
                Confidence History
            </h2>
            <div class="space-y-3">
                @foreach (var entry in Model.History)
                {
                    var confClass = entry.OverallConfidence >= 0.8 ? "bg-green-900/300" : entry.OverallConfidence >= 0.6 ? "bg-yellow-900/300" : "bg-red-500";
                    <div class="flex items-center gap-3 p-2 bg-midnight rounded-lg">
                        <div class="w-12 h-12 rounded-lg @(entry.OverallConfidence >= 0.8 ? "bg-green-900/300/20" : entry.OverallConfidence >= 0.6 ? "bg-yellow-900/300/20" : "bg-red-500/20") flex items-center justify-center">
                            <span class="text-sm font-bold @(entry.OverallConfidence >= 0.8 ? "text-green-400" : entry.OverallConfidence >= 0.6 ? "text-yellow-400" : "text-red-400")">@((entry.OverallConfidence * 100).ToString("F0"))%</span>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <span class="text-soft-white text-sm">@entry.SuccessfulModels/@entry.ModelsUsed models</span>
                                <span class="text-graphite text-xs">@entry.CreatedAt.ToString("HH:mm")</span>
                            </div>
                            <div class="flex items-center gap-2 mt-1">
                                <div class="flex-1 h-1.5 bg-navy rounded-full overflow-hidden">
                                    <div class="h-full @confClass rounded-full" style="width: @((entry.OverallConfidence * 100).ToString("F0"))%"></div>
                                </div>
                                @if (entry.DisagreementCount > 0)
                                {
                                    <span class="text-xs text-orange-400">@entry.DisagreementCount disagreements</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Disagreement Trends -->
        <div class="card">
            <h2 class="text-lg font-semibold text-soft-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Model Disagreement Trends (7 days)
            </h2>
            @if (Model.Trends.Count == 0)
            {
                <div class="text-center py-8 text-graphite">
                    <p>No disagreement trends available yet.</p>
                </div>
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var trend in Model.Trends)
                    {
                        var avgClass = trend.AvgDisagreement <= 0.2 ? "text-green-400" : trend.AvgDisagreement <= 0.4 ? "text-yellow-400" : "text-red-400";
                        var barClass = trend.AvgDisagreement <= 0.2 ? "bg-green-900/300" : trend.AvgDisagreement <= 0.4 ? "bg-yellow-900/300" : "bg-red-500";
                        <div class="p-3 bg-midnight rounded-lg">
                            <div class="flex items-center justify-between mb-2">
                                <span class="text-soft-white text-sm font-medium">@trend.ModelPair</span>
                                <span class="text-xs text-graphite">@trend.OccurrenceCount runs</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="flex-1">
                                    <div class="h-2 bg-navy rounded-full overflow-hidden">
                                        <div class="h-full @barClass rounded-full" style="width: @((trend.AvgDisagreement * 100).ToString("F0"))%"></div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <span class="@avgClass font-medium">@((trend.AvgDisagreement * 100).ToString("F0"))%</span>
                                    <span class="text-graphite text-xs block">avg</span>
                                </div>
                                <div class="text-right">
                                    <span class="text-soft-white font-medium">@((trend.MaxDisagreement * 100).ToString("F0"))%</span>
                                    <span class="text-graphite text-xs block">max</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Recent Runs Table -->
    <div class="card mt-6">
        <h2 class="text-lg font-semibold text-soft-white mb-4 flex items-center gap-2">
            <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
            Recent Reasoning Runs
        </h2>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-graphite text-sm border-b border-slate">
                        <th class="pb-3 font-medium">Time</th>
                        <th class="pb-3 font-medium">Confidence</th>
                        <th class="pb-3 font-medium">Models</th>
                        <th class="pb-3 font-medium">Insights</th>
                        <th class="pb-3 font-medium">Disagreements</th>
                        <th class="pb-3 font-medium">Duration</th>
                        <th class="pb-3 font-medium">Project</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in Model.RecentRuns)
                    {
                        var confClass = run.OverallConfidence >= 0.8 ? "text-green-400" : run.OverallConfidence >= 0.6 ? "text-yellow-400" : "text-red-400";
                        <tr class="border-b border-slate/50 hover:bg-midnight/50 transition">
                            <td class="py-3 text-soft-white">@run.CreatedAt.ToString("HH:mm:ss")</td>
                            <td class="py-3">
                                <span class="@confClass font-medium">@((run.OverallConfidence * 100).ToString("F0"))%</span>
                            </td>
                            <td class="py-3 text-soft-white">@run.SuccessfulModels/@run.ModelsUsed</td>
                            <td class="py-3 text-cyan">@run.InsightCount</td>
                            <td class="py-3">
                                @if (run.DisagreementCount > 0)
                                {
                                    <span class="px-2 py-0.5 bg-orange-500/20 text-orange-400 rounded text-xs">@run.DisagreementCount</span>
                                }
                                else
                                {
                                    <span class="text-graphite">0</span>
                                }
                            </td>
                            <td class="py-3 text-graphite">@run.TotalDurationMs ms</td>
                            <td class="py-3 text-soft-white">@(run.ProjectFilter ?? "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
