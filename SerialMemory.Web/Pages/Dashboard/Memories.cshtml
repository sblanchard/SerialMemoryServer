@page
@model SerialMemory.Web.Pages.Dashboard.MemoriesModel
@{
    ViewData["Title"] = "Memories";
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    <style>
        .memory-card {
            background-color: var(--navy);
            border: 1px solid var(--slate);
            border-radius: 0.75rem;
            padding: 1.25rem;
            transition: all 0.3s ease;
        }
        .memory-card:hover {
            border-color: var(--cyan);
            box-shadow: 0 0 20px rgba(34, 211, 238, 0.15);
        }
        .memory-content {
            color: var(--soft-white);
            line-height: 1.6;
        }
        .memory-content.text-only {
            white-space: pre-wrap;
        }
        .memory-meta {
            color: var(--graphite);
            font-size: 0.75rem;
        }
        .entity-tag {
            background-color: var(--slate);
            color: var(--cyan);
            padding: 0.125rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.7rem;
        }
        .search-input {
            background-color: var(--navy);
            border: 1px solid var(--slate);
            color: var(--soft-white);
        }
        .search-input:focus {
            border-color: var(--cyan);
            outline: none;
            box-shadow: 0 0 0 2px rgba(34, 211, 238, 0.2);
        }
        .search-mode-btn {
            background-color: var(--slate);
            color: var(--graphite);
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-size: 0.875rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .search-mode-btn:hover {
            color: var(--soft-white);
        }
        .search-mode-btn.active {
            background: linear-gradient(90deg, var(--electric), var(--cyan));
            color: white;
        }
        .similarity-bar {
            height: 4px;
            border-radius: 2px;
            background-color: var(--slate);
            overflow: hidden;
        }
        .similarity-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--electric), var(--cyan));
            transition: width 0.3s ease;
        }
        .loading-spinner {
            border: 3px solid var(--slate);
            border-top: 3px solid var(--cyan);
            border-radius: 50%;
            width: 24px;
            height: 24px;
            animation: spin 1s linear infinite;
        }
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: var(--graphite);
        }
        .empty-state svg {
            width: 64px;
            height: 64px;
            margin: 0 auto 1rem;
            opacity: 0.5;
        }

        /* Code block styling */
        .code-block-wrapper {
            position: relative;
            margin: 0.5rem 0;
        }
        .code-block-wrapper pre {
            margin: 0;
            border-radius: 0.5rem;
            max-height: 300px;
            overflow: auto;
        }
        .code-block-wrapper.collapsed pre {
            max-height: 150px;
            overflow: hidden;
        }
        .code-block-wrapper pre code {
            font-family: 'JetBrains Mono', 'Fira Code', monospace;
            font-size: 0.8rem;
            line-height: 1.5;
        }
        .code-block-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--slate);
            padding: 0.25rem 0.75rem;
            border-radius: 0.5rem 0.5rem 0 0;
            font-size: 0.7rem;
            color: var(--graphite);
        }
        .code-block-header + pre {
            border-radius: 0 0 0.5rem 0.5rem;
        }
        .code-block-actions {
            display: flex;
            gap: 0.5rem;
        }
        .code-action-btn {
            background: transparent;
            border: none;
            color: var(--graphite);
            cursor: pointer;
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-size: 0.65rem;
            transition: all 0.2s;
        }
        .code-action-btn:hover {
            background: var(--navy);
            color: var(--cyan);
        }
        .code-action-btn.copied {
            color: var(--success);
        }
        .expand-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            height: 60px;
            background: linear-gradient(transparent, var(--navy));
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding-bottom: 0.5rem;
        }
        .expand-btn {
            background: var(--slate);
            border: 1px solid var(--graphite);
            color: var(--soft-white);
            padding: 0.25rem 0.75rem;
            border-radius: 0.25rem;
            font-size: 0.7rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .expand-btn:hover {
            border-color: var(--cyan);
            color: var(--cyan);
        }
        .language-badge {
            text-transform: uppercase;
            font-weight: 600;
        }
    </style>
}

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Header -->
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-2xl font-bold gradient-text">Memories</h1>
            <p class="text-graphite mt-1">Search and browse your knowledge graph memories</p>
        </div>
        <div class="text-right">
            <span class="text-2xl font-bold text-cyan" id="total-count">0</span>
            <span class="text-graphite text-sm block">total memories</span>
        </div>
    </div>

    <!-- Search -->
    <div class="card mb-6">
        <div class="flex flex-col gap-4">
            <div class="flex gap-4">
                <input type="text" id="search-input" placeholder="Search your memories..."
                    class="flex-1 search-input px-4 py-3 rounded-lg text-lg">
                <button id="btn-search" class="btn-primary px-6 py-3 rounded-lg font-medium">
                    Search
                </button>
            </div>
            <div class="flex gap-2">
                <button class="search-mode-btn active" data-mode="hybrid">Hybrid</button>
                <button class="search-mode-btn" data-mode="semantic">Semantic</button>
                <button class="search-mode-btn" data-mode="text">Text</button>
            </div>
        </div>
    </div>

    <!-- Results -->
    <div id="loading" class="hidden flex justify-center py-8">
        <div class="loading-spinner"></div>
    </div>

    <div id="memories-list" class="space-y-4">
        <!-- Populated by JS -->
    </div>

    <div id="empty-state" class="empty-state hidden">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
        </svg>
        <h3 class="text-lg font-medium text-soft-white mb-2">No memories found</h3>
        <p>Try a different search query or ingest some memories first.</p>
    </div>

    <!-- Load more -->
    <div id="load-more" class="hidden text-center py-6">
        <button id="btn-load-more" class="btn-outline px-6 py-2 rounded-lg">
            Load More
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/csharp.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/sql.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js"></script>
    <script>
        const API_BASE = '@Model.ApiBaseUrl';
        const AUTH_TOKEN = '@Model.AuthToken';
        const COLLAPSE_THRESHOLD = 10; // Lines before collapsing

        let currentMode = 'hybrid';
        let currentQuery = '';
        let currentOffset = 0;
        const PAGE_SIZE = 20;
        let blockIdCounter = 0;

        // Detect language from content
        function detectLanguage(content) {
            if (!content || typeof content !== 'string') return 'text';
            const trimmed = content.trim();

            // Check for JSON
            if ((trimmed.startsWith('{') && trimmed.endsWith('}')) ||
                (trimmed.startsWith('[') && trimmed.endsWith(']'))) {
                try {
                    JSON.parse(trimmed);
                    return 'json';
                } catch {}
            }

            // Check for XML/HTML
            if (trimmed.startsWith('<') && /^<[a-zA-Z]/.test(trimmed)) {
                if (trimmed.includes('<!DOCTYPE html') || trimmed.includes('<html')) return 'html';
                return 'xml';
            }

            // Check for YAML
            if (/^\s*[\w-]+\s*:\s*\S/m.test(trimmed) && !trimmed.includes(';') && !trimmed.includes('{')) {
                return 'yaml';
            }

            // Check for SQL
            if (/\b(SELECT|INSERT|UPDATE|DELETE|CREATE|ALTER|DROP|FROM|WHERE|JOIN|GROUP BY|ORDER BY)\b/i.test(trimmed)) {
                return 'sql';
            }

            // Check for C#
            const csharpIndicators = [
                'builder.Services', 'IServiceCollection', 'AddScoped', 'AddSingleton', 'AddTransient',
                'namespace ', 'using System', 'public class ', 'private class ', 'internal class ',
                'public sealed class ', 'public interface ', 'async Task', '=> ', '.ConfigureAwait(',
                'var ', 'ILogger<', 'IConfiguration', '[Authorize]', '[HttpGet]', '[HttpPost]',
                'public record ', 'public enum '
            ];
            if (csharpIndicators.some(i => trimmed.includes(i))) return 'csharp';

            // Semicolon-heavy with braces = C-style
            const semicolonCount = (trimmed.match(/;/g) || []).length;
            const lineCount = trimmed.split('\n').length;
            if (lineCount > 2 && semicolonCount >= lineCount / 2 && trimmed.includes('{') && trimmed.includes('}')) {
                return 'csharp';
            }

            // Check for JavaScript/TypeScript
            if (/\b(function|const|let|var|=>|import|export|require\(|module\.exports)\b/.test(trimmed)) {
                return 'javascript';
            }

            // Check for Python
            if (/(^def |^class |^import |^from .+ import|if __name__|print\(|self\.|async def )/m.test(trimmed)) {
                return 'python';
            }

            // Check for Bash
            if (/(^#!\/bin\/|^\s*\$\s+|^echo |^export |^source |^alias |\|\s*grep|\|\s*awk|\|\s*sed)/m.test(trimmed)) {
                return 'bash';
            }

            return 'text';
        }

        // Format JSON with pretty-printing
        function formatJson(json) {
            try {
                return JSON.stringify(JSON.parse(json), null, 2);
            } catch {
                return json;
            }
        }

        // Format memory content with code detection
        function formatMemoryContent(content) {
            if (!content) return { html: '', isCode: false };

            // If already has fenced code blocks, parse and render them
            if (content.includes('```')) {
                return { html: renderMarkdownCodeBlocks(content), isCode: true };
            }

            const language = detectLanguage(content);

            if (language === 'text') {
                return { html: escapeHtml(content), isCode: false };
            }

            // Format JSON if detected
            let code = content;
            if (language === 'json') {
                code = formatJson(content);
            }

            return { html: renderCodeBlock(code, language), isCode: true };
        }

        // Render markdown-style code blocks
        function renderMarkdownCodeBlocks(content) {
            const parts = [];
            let lastIndex = 0;
            const regex = /```(\w*)\n?([\s\S]*?)```/g;
            let match;

            while ((match = regex.exec(content)) !== null) {
                // Add text before code block
                if (match.index > lastIndex) {
                    parts.push(escapeHtml(content.slice(lastIndex, match.index)));
                }

                const lang = match[1] || detectLanguage(match[2]);
                parts.push(renderCodeBlock(match[2], lang));
                lastIndex = match.index + match[0].length;
            }

            // Add remaining text
            if (lastIndex < content.length) {
                parts.push(escapeHtml(content.slice(lastIndex)));
            }

            return parts.join('');
        }

        // Render a single code block with header and actions
        function renderCodeBlock(code, language) {
            const blockId = `code-block-${++blockIdCounter}`;
            const lineCount = code.split('\n').length;
            const needsCollapse = lineCount > COLLAPSE_THRESHOLD;
            const langDisplay = language === 'csharp' ? 'C#' : language.toUpperCase();

            const escapedCode = escapeHtml(code.trim());
            const highlightedCode = language !== 'text'
                ? hljs.highlight(code.trim(), { language: language === 'csharp' ? 'csharp' : language }).value
                : escapedCode;

            return `
                <div class="code-block-wrapper ${needsCollapse ? 'collapsed' : ''}" id="${blockId}" data-code="${encodeURIComponent(code.trim())}">
                    <div class="code-block-header">
                        <span class="language-badge">${langDisplay}</span>
                        <div class="code-block-actions">
                            <button class="code-action-btn" onclick="copyCode('${blockId}')" title="Copy code">Copy</button>
                            ${needsCollapse ? `<button class="code-action-btn" onclick="toggleExpand('${blockId}')" title="Expand/collapse">Expand</button>` : ''}
                        </div>
                    </div>
                    <pre><code class="hljs language-${language}">${highlightedCode}</code></pre>
                    ${needsCollapse ? `
                        <div class="expand-overlay">
                            <button class="expand-btn" onclick="toggleExpand('${blockId}')">Show more (${lineCount} lines)</button>
                        </div>
                    ` : ''}
                </div>
            `;
        }

        // Copy code to clipboard
        async function copyCode(blockId) {
            const block = document.getElementById(blockId);
            const code = decodeURIComponent(block.dataset.code);
            await navigator.clipboard.writeText(code);

            const btn = block.querySelector('.code-action-btn');
            btn.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
                btn.textContent = 'Copy';
                btn.classList.remove('copied');
            }, 2000);
        }

        // Toggle expand/collapse
        function toggleExpand(blockId) {
            const block = document.getElementById(blockId);
            const isCollapsed = block.classList.contains('collapsed');
            block.classList.toggle('collapsed');

            const overlay = block.querySelector('.expand-overlay');
            const expandBtn = block.querySelector('.code-block-actions .code-action-btn:last-child');

            if (isCollapsed) {
                if (overlay) overlay.style.display = 'none';
                if (expandBtn) expandBtn.textContent = 'Collapse';
            } else {
                if (overlay) overlay.style.display = 'flex';
                if (expandBtn) expandBtn.textContent = 'Expand';
            }
        }

        // Format date
        function formatDate(dateStr) {
            const date = new Date(dateStr);
            return date.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit'
            });
        }

        // Render memory card
        function renderMemoryCard(memory) {
            const similarity = memory.similarity || memory.score || 0;
            const entities = memory.entities || [];
            const formatted = formatMemoryContent(memory.content);

            return `
                <div class="memory-card">
                    <div class="memory-content mb-3 ${formatted.isCode ? '' : 'text-only'}">${formatted.html}</div>
                    <div class="flex justify-between items-end">
                        <div>
                            <div class="memory-meta mb-2">${formatDate(memory.createdAt)}</div>
                            ${entities.length > 0 ? `
                                <div class="flex flex-wrap gap-1">
                                    ${entities.slice(0, 5).map(e => `<span class="entity-tag">${escapeHtml(typeof e === 'string' ? e : e.name)}</span>`).join('')}
                                    ${entities.length > 5 ? `<span class="entity-tag">+${entities.length - 5} more</span>` : ''}
                                </div>
                            ` : ''}
                        </div>
                        ${similarity > 0 ? `
                            <div class="text-right">
                                <div class="text-xs text-graphite mb-1">${Math.round(similarity * 100)}% match</div>
                                <div class="similarity-bar w-20">
                                    <div class="similarity-fill" style="width: ${similarity * 100}%"></div>
                                </div>
                            </div>
                        ` : ''}
                    </div>
                </div>
            `;
        }

        // Escape HTML
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text || '';
            return div.innerHTML;
        }

        // Search memories
        async function searchMemories(query, mode, offset = 0) {
            const list = document.getElementById('memories-list');
            const loading = document.getElementById('loading');
            const emptyState = document.getElementById('empty-state');
            const loadMore = document.getElementById('load-more');

            if (offset === 0) {
                list.innerHTML = '';
                loading.classList.remove('hidden');
            }

            try {
                let url;
                if (query) {
                    url = `${API_BASE}/api/memories/search?query=${encodeURIComponent(query)}&mode=${mode}&limit=${PAGE_SIZE}&offset=${offset}`;
                } else {
                    url = `${API_BASE}/api/memories/recent?limit=${PAGE_SIZE}&offset=${offset}`;
                }

                const response = await fetch(url, {
                    credentials: 'same-origin'
                });

                if (!response.ok) throw new Error('Failed to fetch memories');

                const memories = await response.json();
                loading.classList.add('hidden');

                if (memories.length === 0 && offset === 0) {
                    emptyState.classList.remove('hidden');
                    loadMore.classList.add('hidden');
                    return;
                }

                emptyState.classList.add('hidden');

                memories.forEach(memory => {
                    list.insertAdjacentHTML('beforeend', renderMemoryCard(memory));
                });

                // Show/hide load more
                if (memories.length >= PAGE_SIZE) {
                    loadMore.classList.remove('hidden');
                } else {
                    loadMore.classList.add('hidden');
                }

            } catch (error) {
                console.error('Error searching memories:', error);
                loading.classList.add('hidden');
                if (offset === 0) {
                    emptyState.classList.remove('hidden');
                }
            }
        }

        // Fetch stats
        async function fetchStats() {
            try {
                const response = await fetch(`${API_BASE}/api/stats`, {
                    credentials: 'same-origin'
                });

                if (!response.ok) return;

                const stats = await response.json();
                document.getElementById('total-count').textContent = stats.memories || 0;
            } catch (error) {
                console.error('Error fetching stats:', error);
            }
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', async () => {
            await fetchStats();
            await searchMemories('', currentMode, 0);

            // Search mode buttons
            document.querySelectorAll('.search-mode-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    document.querySelectorAll('.search-mode-btn').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentMode = btn.dataset.mode;
                    if (currentQuery) {
                        currentOffset = 0;
                        searchMemories(currentQuery, currentMode, 0);
                    }
                });
            });

            // Search button
            document.getElementById('btn-search').addEventListener('click', () => {
                currentQuery = document.getElementById('search-input').value;
                currentOffset = 0;
                searchMemories(currentQuery, currentMode, 0);
            });

            // Enter key
            document.getElementById('search-input').addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    currentQuery = e.target.value;
                    currentOffset = 0;
                    searchMemories(currentQuery, currentMode, 0);
                }
            });

            // Load more
            document.getElementById('btn-load-more').addEventListener('click', () => {
                currentOffset += PAGE_SIZE;
                searchMemories(currentQuery, currentMode, currentOffset);
            });
        });
    </script>
}
