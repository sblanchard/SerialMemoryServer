@page "/dashboard/mutations"
@model SerialMemory.Web.Pages.Dashboard.MutationsModel
@{
    ViewData["Title"] = "Mutations";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">Mutation Console</h1>
            <p class="mt-2 text-graphite">Event-sourced mutation queue and sequence index.</p>
        </div>
        <div class="flex gap-2">
            @if (Model.Stats?.IsPaused == true)
            {
                <form method="post" asp-page-handler="ResumeProcessing" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                        Resume Processing
                    </button>
                </form>
            }
            else
            {
                <form method="post" asp-page-handler="PauseProcessing" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                        Pause Processing
                    </button>
                </form>
            }
            <form method="post" asp-page-handler="ForceFlush" class="inline" onsubmit="return confirm('Force flush all pending mutations?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="bg-orange-600 hover:bg-orange-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                    Force Flush
                </button>
            </form>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-7 gap-4 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Current Sequence</div>
            <div class="mt-1 text-2xl font-semibold text-cyan font-mono">@Model.CurrentSequence.ToString("N0")</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Processed</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Stats?.TotalProcessed.ToString("N0") ?? "—")</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Pending</div>
            <div class="mt-1 text-2xl font-semibold text-yellow-400">@(Model.Stats?.PendingCount ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Failed</div>
            <div class="mt-1 text-2xl font-semibold text-red-400">@(Model.Stats?.FailedCount ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Avg Processing</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Stats?.AvgProcessingMs.ToString("F1") ?? "—") ms</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Mutations/sec</div>
            <div class="mt-1 text-2xl font-semibold text-electric">@(Model.Stats?.MutationsPerSecond.ToString("F2") ?? "—")</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Status</div>
            <div class="mt-1 text-2xl font-semibold @(Model.Stats?.IsPaused == true ? "text-yellow-400" : "text-green-400")">
                @(Model.Stats?.IsPaused == true ? "Paused" : "Running")
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Pending Mutations -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Pending Mutations (@Model.PendingMutations.Count)</h3>
            <div class="space-y-3 max-h-[500px] overflow-y-auto">
                @foreach (var mutation in Model.PendingMutations)
                {
                    <div class="bg-slate/30 rounded-md p-3">
                        <div class="flex justify-between items-start mb-2">
                            <span class="px-2 py-1 text-xs rounded bg-yellow-600 text-white">@mutation.MutationType</span>
                            <span class="text-xs text-graphite">@mutation.Status</span>
                        </div>
                        <div class="text-xs font-mono text-graphite mb-1">Target: @mutation.TargetMemoryId.ToString()[..8]...</div>
                        @if (!string.IsNullOrEmpty(mutation.Summary))
                        {
                            <div class="text-sm text-soft-white mb-2">@mutation.Summary</div>
                        }
                        <div class="flex justify-between items-center text-xs text-graphite mb-2">
                            <span>Queued: @mutation.QueuedAt.ToString("HH:mm:ss")</span>
                            @if (mutation.RetryCount > 0)
                            {
                                <span class="text-yellow-400">Retries: @mutation.RetryCount</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(mutation.PayloadJson))
                        {
                            <details class="mb-2">
                                <summary class="text-xs text-electric cursor-pointer hover:underline">View Payload</summary>
                                <pre class="mt-2 text-xs bg-slate/50 rounded-md p-2 overflow-x-auto text-graphite">@mutation.PayloadJson</pre>
                            </details>
                        }
                        <div class="flex gap-2">
                            <form method="post" asp-page-handler="ApproveMutation" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="mutationId" value="@mutation.Id" />
                                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-2 py-1 rounded text-xs transition">
                                    Approve
                                </button>
                            </form>
                            <button onclick="showRejectModal('@mutation.Id')" class="bg-red-600 hover:bg-red-700 text-white px-2 py-1 rounded text-xs transition">
                                Reject
                            </button>
                        </div>
                    </div>
                }
                @if (Model.PendingMutations.Count == 0)
                {
                    <div class="text-center text-graphite py-8">No pending mutations</div>
                }
            </div>
        </div>

        <!-- Recent Mutations (Processed) -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Recent Mutations</h3>
            <div class="overflow-x-auto max-h-[500px]">
                <table class="min-w-full">
                    <thead class="sticky top-0 bg-navy">
                        <tr class="border-b border-slate">
                            <th class="px-2 py-2 text-left text-xs font-medium text-graphite uppercase">Seq</th>
                            <th class="px-2 py-2 text-left text-xs font-medium text-graphite uppercase">Type</th>
                            <th class="px-2 py-2 text-left text-xs font-medium text-graphite uppercase">Status</th>
                            <th class="px-2 py-2 text-left text-xs font-medium text-graphite uppercase">Time</th>
                            <th class="px-2 py-2 text-right text-xs font-medium text-graphite uppercase">Duration</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate">
                        @foreach (var mutation in Model.RecentMutations)
                        {
                            <tr class="hover:bg-slate/30">
                                <td class="px-2 py-2 text-sm font-mono text-graphite">@mutation.SequenceNumber</td>
                                <td class="px-2 py-2 text-sm text-soft-white">@mutation.MutationType</td>
                                <td class="px-2 py-2">
                                    <span class="px-2 py-0.5 text-xs rounded @(mutation.Status == "Completed" ? "bg-green-600" : mutation.Status == "Failed" ? "bg-red-600" : "bg-yellow-600") text-white">
                                        @mutation.Status
                                    </span>
                                </td>
                                <td class="px-2 py-2 text-sm text-graphite">@mutation.ProcessedAt.ToString("HH:mm:ss")</td>
                                <td class="px-2 py-2 text-sm text-right @(mutation.DurationMs > 500 ? "text-yellow-400" : "text-soft-white")">
                                    @mutation.DurationMs.ToString("F1") ms
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(mutation.Error))
                            {
                                <tr class="bg-red-900/20">
                                    <td colspan="5" class="px-2 py-1 text-xs text-red-300">@mutation.Error</td>
                                </tr>
                            }
                        }
                        @if (Model.RecentMutations.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="px-2 py-4 text-center text-graphite">No recent mutations</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Replay from Sequence -->
    <div class="card mt-6">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Replay from Sequence</h3>
        <form method="post" asp-page-handler="ReplayFromSequence" class="flex flex-wrap gap-4 items-end" onsubmit="return confirm('This will replay all mutations from the specified sequence. Continue?');">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-medium text-graphite mb-1">From Sequence Number</label>
                <input type="number" name="fromSequence" min="0" placeholder="0"
                       class="bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm font-mono focus:outline-none focus:border-electric w-40">
            </div>
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                Start Replay
            </button>
        </form>
        <p class="text-xs text-graphite mt-2">
            Replay re-processes mutations from a specific sequence number. Use this to rebuild projections or recover from errors.
            Current sequence: <span class="font-mono text-cyan">@Model.CurrentSequence</span>
        </p>
    </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-navy border border-slate rounded-lg p-6 max-w-md w-full mx-4">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Reject Mutation</h3>
        <form method="post" asp-page-handler="RejectMutation">
            @Html.AntiForgeryToken()
            <input type="hidden" name="mutationId" id="rejectMutationId" />
            <div class="mb-4">
                <label class="block text-sm font-medium text-graphite mb-2">Reason for rejection</label>
                <textarea name="reason" rows="3" required placeholder="Enter reason..."
                          class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric"></textarea>
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="hideRejectModal()" class="bg-slate hover:bg-gray-600 text-soft-white px-4 py-2 rounded-md text-sm font-medium transition">
                    Cancel
                </button>
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium transition">
                    Reject
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function showRejectModal(mutationId) {
        document.getElementById('rejectMutationId').value = mutationId;
        document.getElementById('rejectModal').classList.remove('hidden');
        document.getElementById('rejectModal').classList.add('flex');
    }

    function hideRejectModal() {
        document.getElementById('rejectModal').classList.add('hidden');
        document.getElementById('rejectModal').classList.remove('flex');
    }
</script>
}
