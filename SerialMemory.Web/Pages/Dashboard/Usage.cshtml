@page "/dashboard/usage"
@model SerialMemory.Web.Pages.Dashboard.UsageModel
@{
    ViewData["Title"] = "Usage";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white">Usage</h1>
        <p class="mt-2 text-graphite">Track your API usage and credits consumption.</p>
    </div>

    @if (Model.IsSampleData)
    {
        <div class="mb-6 bg-blue-900/30 border border-blue-500/50 text-blue-300 px-4 py-3 rounded-lg">
            <div class="flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span><strong>Sample Data:</strong> No usage recorded yet. The data shown below is for demonstration purposes. Start using the MCP tools to see real usage metrics.</span>
            </div>
        </div>
    }

    <!-- Current Cycle Overview -->
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Credits Used</div>
            <div class="mt-1 text-3xl font-semibold text-soft-white">@Model.CreditsUsed.ToString("N1")</div>
            <div class="text-sm text-graphite">of @Model.CreditsAllocated.ToString("N0") allocated</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Credits Remaining</div>
            <div class="mt-1 text-3xl font-semibold @(Model.CreditsRemaining < Model.CreditsAllocated * 0.1m ? "text-red-400" : "text-green-400")">
                @Model.CreditsRemaining.ToString("N1")
            </div>
            <div class="text-sm text-graphite">@Model.UsagePercent% used</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Operations</div>
            <div class="mt-1 text-3xl font-semibold text-soft-white">@Model.TotalOperations.ToString("N0")</div>
            <div class="text-sm text-graphite">this billing cycle</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Cycle Ends</div>
            <div class="mt-1 text-3xl font-semibold text-soft-white">@Model.CycleEnd?.ToString("MMM dd")</div>
            <div class="text-sm text-graphite">@Model.DaysRemaining days remaining</div>
        </div>
    </div>

    <!-- Usage Progress Bar -->
    <div class="card mb-8">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Credit Usage</h3>
        <div class="w-full bg-slate rounded-full h-4 mb-2">
            <div class="@(Model.UsagePercent > 90 ? "bg-red-500" : Model.UsagePercent > 75 ? "bg-yellow-900/300" : "bg-electric") h-4 rounded-full transition-all duration-300"
                style="width: @(Math.Min(100, Model.UsagePercent))%"></div>
        </div>
        <div class="flex justify-between text-sm text-graphite">
            <span>0 credits</span>
            <span>@Model.CreditsAllocated.ToString("N0") credits</span>
        </div>
        @if (Model.UsagePercent > 75)
        {
            <div class="mt-4 bg-yellow-900/30 border border-yellow-500/50 text-yellow-300 px-4 py-3 rounded">
                @if (Model.UsagePercent > 90)
                {
                    <strong>Warning:</strong>
                    <text>You've used over 90% of your credits. Consider upgrading your plan to avoid service interruption.</text>
                }
                else
                {
                    <strong>Notice:</strong>
                    <text>You've used over 75% of your credits this cycle.</text>
                }
                <a href="/dashboard/billing" class="ml-2 text-yellow-200 underline hover:text-yellow-100">Upgrade Plan</a>
            </div>
        }
    </div>

    <!-- Usage Breakdown -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Usage by Operation</h3>
            <div class="space-y-3">
                @foreach (var op in Model.UsageByOperation)
                {
                    <div class="flex items-center justify-between">
                        <div>
                            <div class="text-sm font-medium text-soft-white">@op.OperationType</div>
                            <div class="text-xs text-graphite">@op.Count.ToString("N0") operations</div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-semibold text-soft-white">@op.Credits.ToString("N1")</div>
                            <div class="text-xs text-graphite">credits</div>
                        </div>
                    </div>
                }
                @if (Model.UsageByOperation.Count == 0)
                {
                    <div class="text-graphite text-sm">No usage data for this cycle yet.</div>
                }
            </div>
        </div>

        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Daily Usage (Last 7 Days)</h3>
            <div class="space-y-2">
                @foreach (var day in Model.DailyUsage)
                {
                    <div class="flex items-center gap-2">
                        <div class="w-20 text-xs text-graphite">@day.Date.ToString("MMM dd")</div>
                        <div class="flex-1 bg-slate rounded-full h-2">
                            <div class="bg-electric h-2 rounded-full" style="width: @(day.Percent)%"></div>
                        </div>
                        <div class="w-16 text-right text-xs text-graphite">@day.Credits.ToString("N1")</div>
                    </div>
                }
                @if (Model.DailyUsage.Count == 0)
                {
                    <div class="text-graphite text-sm">No daily usage data available.</div>
                }
            </div>
        </div>
    </div>

    <!-- Rate Limits -->
    <div class="card mb-8">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Rate Limits</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <div class="text-sm font-medium text-graphite">Current Rate</div>
                <div class="mt-1 text-2xl font-semibold text-soft-white">@Model.CurrentRatePerMinute <span class="text-sm font-normal text-graphite">req/min</span></div>
            </div>
            <div>
                <div class="text-sm font-medium text-graphite">Plan Limit</div>
                <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.RateLimitPerMinute?.ToString("N0") ?? "Unlimited") <span class="text-sm font-normal text-graphite">req/min</span></div>
            </div>
            <div>
                <div class="text-sm font-medium text-graphite">Rate Limit Hits</div>
                <div class="mt-1 text-2xl font-semibold @(Model.RateLimitHits > 0 ? "text-yellow-400" : "text-graphite")">@Model.RateLimitHits</div>
            </div>
        </div>
    </div>

    <!-- Export Section -->
    <div class="card">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Export Usage Data</h3>
        <p class="text-graphite mb-4">Download your usage data for the current billing cycle.</p>
        <form method="post" asp-page-handler="Export">
            @Html.AntiForgeryToken()
            <button type="submit" class="bg-slate hover:bg-gray-600 text-soft-white px-4 py-2 rounded-md text-sm font-medium transition">
                Download CSV
            </button>
        </form>
    </div>
</div>
