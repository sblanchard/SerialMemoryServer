@page "/dashboard/conflicts"
@model SerialMemory.Web.Pages.Dashboard.ConflictsModel
@{
    ViewData["Title"] = "Conflicts";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">Conflicts & Contradictions</h1>
            <p class="mt-2 text-graphite">Detect and resolve memory conflicts, contradictions, and potential hallucinations.</p>
        </div>
        <form method="post" asp-page-handler="RunDetection">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                Run Detection Scan
            </button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-6 gap-4 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Conflicts</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Stats?.TotalConflicts ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Unresolved</div>
            <div class="mt-1 text-2xl font-semibold text-yellow-400">@(Model.Stats?.UnresolvedConflicts ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Contradictions</div>
            <div class="mt-1 text-2xl font-semibold text-red-400">@(Model.Stats?.TotalContradictions ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Hallucinations</div>
            <div class="mt-1 text-2xl font-semibold text-purple-400">@(Model.Stats?.PotentialHallucinations ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Resolved Today</div>
            <div class="mt-1 text-2xl font-semibold text-green-400">@(Model.Stats?.ResolvedToday ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Detected Today</div>
            <div class="mt-1 text-2xl font-semibold text-cyan">@(Model.Stats?.DetectedToday ?? 0)</div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="mb-6 border-b border-slate">
        <nav class="-mb-px flex space-x-8" id="conflictTabs">
            <button onclick="showTab('conflicts')" class="tab-btn active border-b-2 border-electric py-2 px-1 text-sm font-medium text-electric" data-tab="conflicts">
                Conflicts (@Model.Conflicts.Count)
            </button>
            <button onclick="showTab('contradictions')" class="tab-btn border-b-2 border-transparent py-2 px-1 text-sm font-medium text-graphite hover:text-soft-white" data-tab="contradictions">
                Contradictions (@Model.Contradictions.Count)
            </button>
            <button onclick="showTab('hallucinations')" class="tab-btn border-b-2 border-transparent py-2 px-1 text-sm font-medium text-graphite hover:text-soft-white" data-tab="hallucinations">
                Hallucinations (@Model.Hallucinations.Count)
            </button>
        </nav>
    </div>

    <!-- Conflicts Tab -->
    <div id="tab-conflicts" class="tab-content">
        <div class="space-y-4">
            @foreach (var conflict in Model.Conflicts.Where(c => !c.IsResolved))
            {
                <div class="card">
                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <span class="px-2 py-1 text-xs rounded @(conflict.Severity == "HIGH" ? "bg-red-600" : conflict.Severity == "MEDIUM" ? "bg-yellow-600" : "bg-blue-600") text-white">
                                @conflict.Severity
                            </span>
                            <span class="ml-2 text-sm text-graphite">Similarity: @((conflict.SimilarityScore * 100).ToString("F1"))%</span>
                        </div>
                        <span class="text-xs text-graphite">@conflict.DetectedAt.ToString("g")</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-slate/30 rounded-md p-3">
                            <div class="text-xs text-graphite mb-1 font-mono">@conflict.MemoryAId.ToString()[..8]...</div>
                            <div class="text-sm text-soft-white">@conflict.MemoryAContent</div>
                        </div>
                        <div class="bg-slate/30 rounded-md p-3">
                            <div class="text-xs text-graphite mb-1 font-mono">@conflict.MemoryBId.ToString()[..8]...</div>
                            <div class="text-sm text-soft-white">@conflict.MemoryBContent</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(conflict.Reason))
                    {
                        <div class="text-sm text-graphite mb-4">Reason: @conflict.Reason</div>
                    }

                    <div class="flex flex-wrap gap-2">
                        <form method="post" asp-page-handler="KeepWinner" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conflictId" value="@conflict.Id" />
                            <input type="hidden" name="winnerId" value="@conflict.MemoryAId" />
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm transition">
                                Keep A
                            </button>
                        </form>
                        <form method="post" asp-page-handler="KeepWinner" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conflictId" value="@conflict.Id" />
                            <input type="hidden" name="winnerId" value="@conflict.MemoryBId" />
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm transition">
                                Keep B
                            </button>
                        </form>
                        <button onclick="showMergeModal('@conflict.Id', '@conflict.MemoryAContent.Replace("'", "\\'")', '@conflict.MemoryBContent.Replace("'", "\\'")')"
                                class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-sm transition">
                            Merge Both
                        </button>
                        <form method="post" asp-page-handler="DiscardBoth" class="inline" onsubmit="return confirm('Discard both memories?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="conflictId" value="@conflict.Id" />
                            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm transition">
                                Discard Both
                            </button>
                        </form>
                    </div>
                </div>
            }
            @if (!Model.Conflicts.Any(c => !c.IsResolved))
            {
                <div class="card text-center text-graphite py-8">
                    No unresolved conflicts. Your knowledge graph is consistent.
                </div>
            }
        </div>
    </div>

    <!-- Contradictions Tab -->
    <div id="tab-contradictions" class="tab-content hidden">
        <div class="space-y-4">
            @foreach (var contradiction in Model.Contradictions)
            {
                <div class="card border-l-4 border-red-500">
                    <div class="flex justify-between items-start mb-4">
                        <span class="text-sm font-medium text-red-400">Contradiction Detected</span>
                        <span class="text-xs text-graphite">@contradiction.DetectedAt.ToString("g")</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div class="bg-slate/30 rounded-md p-3">
                            <div class="flex justify-between mb-1">
                                <span class="text-xs text-graphite font-mono">@contradiction.MemoryAId.ToString()[..8]...</span>
                                <span class="text-xs text-cyan">@((contradiction.ConfidenceA * 100).ToString("F0"))% conf</span>
                            </div>
                            <div class="text-sm text-soft-white">@contradiction.MemoryAContent</div>
                        </div>
                        <div class="bg-slate/30 rounded-md p-3">
                            <div class="flex justify-between mb-1">
                                <span class="text-xs text-graphite font-mono">@contradiction.MemoryBId.ToString()[..8]...</span>
                                <span class="text-xs text-cyan">@((contradiction.ConfidenceB * 100).ToString("F0"))% conf</span>
                            </div>
                            <div class="text-sm text-soft-white">@contradiction.MemoryBContent</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(contradiction.Explanation))
                    {
                        <div class="bg-slate/20 rounded-md p-3 text-sm text-graphite">
                            <strong>Analysis:</strong> @contradiction.Explanation
                        </div>
                    }
                </div>
            }
            @if (Model.Contradictions.Count == 0)
            {
                <div class="card text-center text-graphite py-8">
                    No contradictions detected.
                </div>
            }
        </div>
    </div>

    <!-- Hallucinations Tab -->
    <div id="tab-hallucinations" class="tab-content hidden">
        <div class="space-y-4">
            @foreach (var hallucination in Model.Hallucinations)
            {
                <div class="card border-l-4 border-purple-500">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-1 text-xs rounded bg-purple-600 text-white">
                                @((hallucination.HallucinationScore * 100).ToString("F0"))% likely
                            </span>
                            @if (hallucination.IsIsolated)
                            {
                                <span class="px-2 py-1 text-xs rounded bg-yellow-600 text-white">Isolated</span>
                            }
                        </div>
                        <span class="text-xs text-graphite">@hallucination.DetectedAt.ToString("g")</span>
                    </div>

                    <div class="mb-4">
                        <div class="text-xs text-graphite mb-1 font-mono">@hallucination.MemoryId.ToString()[..8]...</div>
                        <div class="text-sm text-soft-white bg-slate/30 rounded-md p-3">@hallucination.Content</div>
                    </div>

                    <div class="grid grid-cols-3 gap-4 mb-4 text-center">
                        <div>
                            <div class="text-xs text-graphite">Confidence</div>
                            <div class="text-sm text-soft-white">@((hallucination.Confidence * 100).ToString("F0"))%</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Validations</div>
                            <div class="text-sm text-soft-white">@hallucination.ValidationCount</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Reason</div>
                            <div class="text-sm text-soft-white truncate">@(hallucination.Reason ?? "Low confidence")</div>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <form method="post" asp-page-handler="DismissHallucination" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memoryId" value="@hallucination.MemoryId" />
                            <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-sm transition">
                                Dismiss (Keep Memory)
                            </button>
                        </form>
                        <form method="post" asp-page-handler="FlagHallucination" class="inline" onsubmit="return confirm('Flag this memory as a hallucination?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="memoryId" value="@hallucination.MemoryId" />
                            <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-sm transition">
                                Confirm Hallucination
                            </button>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Hallucinations.Count == 0)
            {
                <div class="card text-center text-graphite py-8">
                    No potential hallucinations detected.
                </div>
            }
        </div>
    </div>
</div>

<!-- Merge Modal -->
<div id="mergeModal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50">
    <div class="bg-navy border border-slate rounded-lg p-6 max-w-2xl w-full mx-4">
        <h3 class="text-lg font-semibold text-soft-white mb-4">Merge Memories</h3>
        <form method="post" asp-page-handler="MergeBoth">
            @Html.AntiForgeryToken()
            <input type="hidden" name="conflictId" id="mergeConflictId" />
            <div class="mb-4">
                <label class="block text-sm font-medium text-graphite mb-2">Merged Content</label>
                <textarea name="mergedContent" id="mergeContent" rows="6"
                          class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric"></textarea>
            </div>
            <div class="flex justify-end gap-3">
                <button type="button" onclick="hideMergeModal()" class="bg-slate hover:bg-gray-600 text-soft-white px-4 py-2 rounded-md text-sm font-medium transition">
                    Cancel
                </button>
                <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                    Merge
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function showTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.tab-btn').forEach(el => {
            el.classList.remove('active', 'border-electric', 'text-electric');
            el.classList.add('border-transparent', 'text-graphite');
        });

        document.getElementById('tab-' + tabName).classList.remove('hidden');
        const activeBtn = document.querySelector(`[data-tab="${tabName}"]`);
        activeBtn.classList.add('active', 'border-electric', 'text-electric');
        activeBtn.classList.remove('border-transparent', 'text-graphite');
    }

    function showMergeModal(conflictId, contentA, contentB) {
        document.getElementById('mergeConflictId').value = conflictId;
        document.getElementById('mergeContent').value = contentA + '\n\n---\n\n' + contentB;
        document.getElementById('mergeModal').classList.remove('hidden');
        document.getElementById('mergeModal').classList.add('flex');
    }

    function hideMergeModal() {
        document.getElementById('mergeModal').classList.add('hidden');
        document.getElementById('mergeModal').classList.remove('flex');
    }
</script>
}
