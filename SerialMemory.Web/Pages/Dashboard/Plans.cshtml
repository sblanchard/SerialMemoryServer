@page "/dashboard/plans"
@model SerialMemory.Web.Pages.Dashboard.PlansModel
@{
    ViewData["Title"] = "Plans & Pricing";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-soft-white">Choose Your Plan</h1>
        <p class="mt-2 text-graphite">Select the plan that best fits your needs. Upgrade or downgrade anytime.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-900/30 border border-green-500/50 text-green-300 px-4 py-3 rounded-lg mb-6 text-center">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-900/30 border border-red-500/50 text-red-300 px-4 py-3 rounded-lg mb-6 text-center">
            @Model.ErrorMessage
        </div>
    }

    <!-- Billing Interval Toggle -->
    <div class="flex justify-center mb-8">
        <div class="bg-obsidian rounded-lg p-1 inline-flex">
            <a href="?interval=monthly"
               class="px-4 py-2 rounded-md text-sm font-medium transition-colors @(Model.SelectedBillingInterval == "monthly" ? "bg-indigo-600 text-white" : "text-graphite hover:text-soft-white")">
                Monthly
            </a>
            <a href="?interval=quarterly"
               class="px-4 py-2 rounded-md text-sm font-medium transition-colors @(Model.SelectedBillingInterval == "quarterly" ? "bg-indigo-600 text-white" : "text-graphite hover:text-soft-white")">
                Quarterly
                <span class="ml-1 text-xs text-green-400">Save 10%</span>
            </a>
            <a href="?interval=annual"
               class="px-4 py-2 rounded-md text-sm font-medium transition-colors @(Model.SelectedBillingInterval == "annual" ? "bg-indigo-600 text-white" : "text-graphite hover:text-soft-white")">
                Annual
                <span class="ml-1 text-xs text-green-400">Save 20%</span>
            </a>
        </div>
    </div>

    <!-- Plan Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        @foreach (var plan in Model.AvailablePlans)
        {
            var isCurrentPlan = plan.Name.Equals(Model.CurrentPlan, StringComparison.OrdinalIgnoreCase);
            var price = Model.SelectedBillingInterval switch
            {
                "quarterly" => plan.Pricing.Quarterly,
                "annual" => plan.Pricing.Annual,
                _ => plan.Pricing.Monthly
            };
            var pricePerMonth = Model.SelectedBillingInterval switch
            {
                "quarterly" => plan.Pricing.Quarterly / 3,
                "annual" => plan.Pricing.Annual / 12,
                _ => plan.Pricing.Monthly
            };
            var isPopular = plan.Name.Equals("pro", StringComparison.OrdinalIgnoreCase);

            <div class="card relative @(isPopular ? "ring-2 ring-indigo-500" : "") @(isCurrentPlan ? "ring-2 ring-green-500" : "")">
                @if (isPopular && !isCurrentPlan)
                {
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                        <span class="bg-indigo-600 text-white text-xs font-semibold px-3 py-1 rounded-full">Most Popular</span>
                    </div>
                }
                @if (isCurrentPlan)
                {
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                        <span class="bg-green-600 text-white text-xs font-semibold px-3 py-1 rounded-full">Current Plan</span>
                    </div>
                }

                <div class="text-center pt-4">
                    <h3 class="text-xl font-bold text-soft-white">@plan.DisplayName</h3>
                    <div class="mt-4">
                        @if (price == 0)
                        {
                            <span class="text-4xl font-bold text-soft-white">Free</span>
                        }
                        else
                        {
                            <span class="text-4xl font-bold text-soft-white">$@pricePerMonth.ToString("0")</span>
                            <span class="text-graphite">/month</span>
                            @if (Model.SelectedBillingInterval != "monthly")
                            {
                                <div class="text-sm text-graphite mt-1">
                                    Billed $@price.ToString("0.00") @(Model.SelectedBillingInterval == "quarterly" ? "quarterly" : "annually")
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="mt-6 space-y-4">
                    <div class="flex items-center">
                        <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-soft-white">@plan.CreditsPerMonth.ToString("N0") credits/month</span>
                    </div>
                    <div class="flex items-center">
                        <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-soft-white">@(plan.MaxMemories?.ToString("N0") ?? "Unlimited") memories</span>
                    </div>
                    <div class="flex items-center">
                        <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-soft-white">@plan.RateLimitPerMinute req/min</span>
                    </div>
                    <div class="flex items-center">
                        @if (plan.Features.ApiAccess)
                        {
                            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 text-graphite mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        }
                        <span class="@(plan.Features.ApiAccess ? "text-soft-white" : "text-graphite")">API Access</span>
                    </div>
                    <div class="flex items-center">
                        @if (plan.Features.AdvancedAnalytics)
                        {
                            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 text-graphite mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        }
                        <span class="@(plan.Features.AdvancedAnalytics ? "text-soft-white" : "text-graphite")">Advanced Analytics</span>
                    </div>
                    <div class="flex items-center">
                        @if (plan.Features.PrioritySupport)
                        {
                            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 text-graphite mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        }
                        <span class="@(plan.Features.PrioritySupport ? "text-soft-white" : "text-graphite")">Priority Support</span>
                    </div>
                    <div class="flex items-center">
                        @if (plan.Features.CustomIntegrations)
                        {
                            <svg class="w-5 h-5 text-green-500 mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5 text-graphite mr-3" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                            </svg>
                        }
                        <span class="@(plan.Features.CustomIntegrations ? "text-soft-white" : "text-graphite")">Custom Integrations</span>
                    </div>
                </div>

                <div class="mt-8">
                    @if (isCurrentPlan)
                    {
                        <button disabled class="w-full py-3 px-4 rounded-lg bg-slate text-graphite cursor-not-allowed">
                            Current Plan
                        </button>
                    }
                    else if (price == 0)
                    {
                        <form method="post" asp-page-handler="SelectPlan">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="@plan.Name" />
                            <input type="hidden" name="interval" value="@Model.SelectedBillingInterval" />
                            <button type="submit" class="w-full py-3 px-4 rounded-lg bg-slate hover:bg-slate/80 text-soft-white font-medium transition-colors">
                                Downgrade to Free
                            </button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="SelectPlan">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="@plan.Name" />
                            <input type="hidden" name="interval" value="@Model.SelectedBillingInterval" />
                            <button type="submit" class="w-full py-3 px-4 rounded-lg @(isPopular ? "bg-indigo-600 hover:bg-indigo-700" : "bg-slate hover:bg-slate/80") text-soft-white font-medium transition-colors">
                                @(Model.CurrentPlan?.Equals(plan.Name, StringComparison.OrdinalIgnoreCase) != true && price > 0 ? "Upgrade to " : "Select ") @plan.DisplayName
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>

    <!-- Feature Comparison Table -->
    <div class="card">
        <h2 class="text-xl font-bold text-soft-white mb-6">Feature Comparison</h2>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="border-b border-slate">
                        <th class="text-left py-3 px-4 text-graphite font-medium">Feature</th>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <th class="text-center py-3 px-4 text-soft-white font-medium">@plan.DisplayName</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">Monthly Credits</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4 text-soft-white">@plan.CreditsPerMonth.ToString("N0")</td>
                        }
                    </tr>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">Max Memories</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4 text-soft-white">@(plan.MaxMemories?.ToString("N0") ?? "Unlimited")</td>
                        }
                    </tr>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">Rate Limit</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4 text-soft-white">@plan.RateLimitPerMinute/min</td>
                        }
                    </tr>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">API Access</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4">
                                @if (plan.Features.ApiAccess)
                                {
                                    <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                }
                                else
                                {
                                    <span class="text-graphite">-</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">Advanced Analytics</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4">
                                @if (plan.Features.AdvancedAnalytics)
                                {
                                    <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                }
                                else
                                {
                                    <span class="text-graphite">-</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr class="border-b border-slate/50">
                        <td class="py-3 px-4 text-soft-white">Priority Support</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4">
                                @if (plan.Features.PrioritySupport)
                                {
                                    <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                }
                                else
                                {
                                    <span class="text-graphite">-</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="py-3 px-4 text-soft-white">Custom Integrations</td>
                        @foreach (var plan in Model.AvailablePlans)
                        {
                            <td class="text-center py-3 px-4">
                                @if (plan.Features.CustomIntegrations)
                                {
                                    <svg class="w-5 h-5 text-green-500 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                                    </svg>
                                }
                                else
                                {
                                    <span class="text-graphite">-</span>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- FAQ Section -->
    <div class="mt-12">
        <h2 class="text-xl font-bold text-soft-white mb-6 text-center">Frequently Asked Questions</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="card">
                <h3 class="font-semibold text-soft-white mb-2">Can I upgrade or downgrade anytime?</h3>
                <p class="text-graphite">Yes! You can change your plan at any time. When upgrading, you'll be charged a prorated amount. When downgrading, the change takes effect at the end of your billing period.</p>
            </div>
            <div class="card">
                <h3 class="font-semibold text-soft-white mb-2">What happens to unused credits?</h3>
                <p class="text-graphite">Unused credits expire at the end of each billing period and do not roll over. We recommend choosing a plan that matches your expected usage.</p>
            </div>
            <div class="card">
                <h3 class="font-semibold text-soft-white mb-2">How do billing intervals work?</h3>
                <p class="text-graphite">Choose monthly for flexibility, or commit to quarterly (10% off) or annual billing (20% off) for savings. All credits are allocated upfront.</p>
            </div>
            <div class="card">
                <h3 class="font-semibold text-soft-white mb-2">What payment methods do you accept?</h3>
                <p class="text-graphite">We accept all major credit cards through Stripe. Enterprise customers can also pay via invoice.</p>
            </div>
        </div>
    </div>
</div>
