@page "/dashboard/traces"
@model SerialMemory.Web.Pages.Dashboard.TracesModel
@{
    ViewData["Title"] = "Traces";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white">Memory Traces</h1>
        <p class="mt-2 text-graphite">Event history, audit trails, and raw memory inspection.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left Column: Memory List & Search -->
        <div class="lg:col-span-1 space-y-6">
            <!-- Load Memory -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Load Memory Trace</h3>
                <form method="post" asp-page-handler="LoadTrace">
                    @Html.AntiForgeryToken()
                    <div class="flex gap-2">
                        <input type="text" name="MemoryId" placeholder="Memory ID (GUID)"
                               class="flex-1 bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm font-mono focus:outline-none focus:border-electric">
                        <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">Load</button>
                    </div>
                </form>
            </div>

            <!-- Event Filter -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Filter by Event Type</h3>
                <div class="flex flex-wrap gap-2">
                    <a href="/dashboard/traces" class="px-3 py-1 rounded text-sm @(string.IsNullOrEmpty(Model.EventFilter) ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">All</a>
                    <a href="/dashboard/traces?eventFilter=MemoryCreated" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryCreated" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Created</a>
                    <a href="/dashboard/traces?eventFilter=MemoryUpdated" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryUpdated" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Updated</a>
                    <a href="/dashboard/traces?eventFilter=MemoryDecayed" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryDecayed" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Decayed</a>
                    <a href="/dashboard/traces?eventFilter=MemoryReinforced" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryReinforced" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Reinforced</a>
                    <a href="/dashboard/traces?eventFilter=MemoryMerged" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryMerged" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Merged</a>
                    <a href="/dashboard/traces?eventFilter=MemoryInvalidated" class="px-3 py-1 rounded text-sm @(Model.EventFilter == "MemoryInvalidated" ? "bg-electric text-white" : "bg-slate text-soft-white hover:bg-slate/70")">Invalidated</a>
                </div>
            </div>

            <!-- Recent Traces -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Recent Activity</h3>
                <div class="space-y-2 max-h-[400px] overflow-y-auto">
                    @foreach (var trace in Model.Traces)
                    {
                        <a href="/dashboard/traces?id=@trace.MemoryId"
                           class="block bg-slate/30 hover:bg-slate/50 rounded-md p-2 transition">
                            <div class="flex justify-between items-start mb-1">
                                <span class="text-xs font-mono text-graphite">@trace.MemoryId.ToString()[..8]...</span>
                                <span class="text-xs @(trace.IsActive ? "text-green-400" : "text-red-400")">
                                    @(trace.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                            <div class="text-sm text-soft-white line-clamp-1">@trace.Content</div>
                            <div class="flex justify-between mt-1 text-xs text-graphite">
                                <span class="text-cyan">@trace.LastEventType</span>
                                <span>@trace.EventCount events</span>
                            </div>
                        </a>
                    }
                    @if (Model.Traces.Count == 0)
                    {
                        <div class="text-center text-graphite py-4">No traces found</div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Trace Detail & SQL -->
        <div class="lg:col-span-2 space-y-6">
            @if (Model.SelectedTrace != null)
            {
                <!-- Memory Info -->
                <div class="card">
                    <div class="flex justify-between items-start mb-4">
                        <h3 class="text-lg font-semibold text-soft-white">Memory Trace</h3>
                        <span class="text-xs font-mono text-graphite">@Model.SelectedTrace.MemoryId</span>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                        <div>
                            <div class="text-xs text-graphite">Layer</div>
                            <div class="text-sm text-soft-white">@Model.SelectedTrace.Layer</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Confidence</div>
                            <div class="text-sm text-cyan">@((Model.SelectedTrace.Confidence * 100).ToString("F1"))%</div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Status</div>
                            <div class="text-sm @(Model.SelectedTrace.IsActive ? "text-green-400" : "text-red-400")">
                                @(Model.SelectedTrace.IsActive ? "Active" : "Inactive")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-graphite">Hash</div>
                            <div class="text-sm text-soft-white font-mono truncate">@(Model.SelectedTrace.ContentHash?[..16] ?? "N/A")...</div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="text-xs text-graphite mb-1">Content</div>
                        <div class="text-sm text-soft-white bg-slate/30 rounded-md p-3">@Model.SelectedTrace.Content</div>
                    </div>

                    @if (Model.SelectedTrace.CausalParents.Count > 0)
                    {
                        <div class="mb-4">
                            <div class="text-xs text-graphite mb-1">Causal Parents (@Model.SelectedTrace.CausalParents.Count)</div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var parent in Model.SelectedTrace.CausalParents)
                                {
                                    <a href="/dashboard/traces?id=@parent" class="text-xs font-mono text-electric hover:underline">@parent.ToString()[..8]...</a>
                                }
                            </div>
                        </div>
                    }

                    @if (Model.SelectedTrace.Descendants.Count > 0)
                    {
                        <div class="mb-4">
                            <div class="text-xs text-graphite mb-1">Descendants (@Model.SelectedTrace.Descendants.Count)</div>
                            <div class="flex flex-wrap gap-2">
                                @foreach (var child in Model.SelectedTrace.Descendants)
                                {
                                    <a href="/dashboard/traces?id=@child" class="text-xs font-mono text-electric hover:underline">@child.ToString()[..8]...</a>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Event Timeline -->
                <div class="card">
                    <h3 class="text-lg font-semibold text-soft-white mb-4">Event History (@Model.SelectedTrace.Events.Count events)</h3>
                    <div class="space-y-3 max-h-[400px] overflow-y-auto">
                        @foreach (var evt in Model.SelectedTrace.Events.OrderByDescending(e => e.SequenceNumber))
                        {
                            <div class="border-l-2 @GetEventColor(evt.EventType) pl-4 py-2">
                                <div class="flex justify-between items-start">
                                    <span class="text-sm font-medium text-soft-white">@evt.EventType</span>
                                    <span class="text-xs text-graphite">seq #@evt.SequenceNumber</span>
                                </div>
                                <div class="text-xs text-graphite mt-1">
                                    @evt.Timestamp.ToString("g")
                                    @if (!string.IsNullOrEmpty(evt.ActorId))
                                    {
                                        <span>by @evt.ActorId</span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(evt.Reason))
                                {
                                    <div class="text-xs text-soft-white mt-1">Reason: @evt.Reason</div>
                                }
                                <details class="mt-2">
                                    <summary class="text-xs text-electric cursor-pointer hover:underline">View Payload</summary>
                                    <pre class="mt-2 text-xs bg-slate/30 rounded-md p-2 overflow-x-auto text-graphite">@evt.PayloadJson</pre>
                                </details>
                            </div>
                        }
                        @if (Model.SelectedTrace.Events.Count == 0)
                        {
                            <div class="text-center text-graphite py-4">No events recorded</div>
                        }
                    </div>
                </div>

                <!-- Raw JSON -->
                <div class="card">
                    <h3 class="text-lg font-semibold text-soft-white mb-4">Raw JSON</h3>
                    <pre class="text-xs bg-slate/30 rounded-md p-4 overflow-x-auto text-graphite max-h-[300px]">@Model.SelectedTrace.RawJson</pre>
                </div>
            }
            else
            {
                <div class="card text-center text-graphite py-8">
                    Select a memory from the list or enter a memory ID to view its trace.
                </div>
            }

            <!-- SQL Console -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">SQL Console (Read-Only)</h3>
                <form method="post" asp-page-handler="ExecuteSql">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <textarea name="SqlQuery" rows="4" placeholder="SELECT * FROM memories LIMIT 10;"
                                  class="w-full bg-slate border border-slate rounded-md px-3 py-2 text-soft-white text-sm focus:outline-none focus:border-electric font-mono">@Model.SqlQuery</textarea>
                    </div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="text-xs text-graphite">Only SELECT and EXPLAIN queries are allowed</span>
                        <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                            Execute Query
                        </button>
                    </div>
                </form>
                @if (!string.IsNullOrEmpty(Model.SqlResult))
                {
                    <div class="mt-4">
                        <div class="text-xs text-graphite mb-2">Result:</div>
                        <pre class="text-xs bg-slate/30 rounded-md p-4 overflow-x-auto text-soft-white max-h-[300px]">@Model.SqlResult</pre>
                    </div>
                }
            </div>

            <!-- Recent Events Log -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Recent Events (All Memories)</h3>
                <div class="overflow-x-auto">
                    <table class="min-w-full">
                        <thead>
                            <tr class="border-b border-slate">
                                <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Seq</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Event</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Memory</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Time</th>
                                <th class="px-3 py-2 text-left text-xs font-medium text-graphite uppercase">Actor</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate">
                            @foreach (var evt in Model.Events.Take(50))
                            {
                                <tr class="hover:bg-slate/30">
                                    <td class="px-3 py-2 text-sm text-graphite font-mono">@evt.SequenceNumber</td>
                                    <td class="px-3 py-2 text-sm text-soft-white">@evt.EventType</td>
                                    <td class="px-3 py-2">
                                        <a href="/dashboard/traces?id=@evt.StreamId" class="text-sm text-electric hover:underline font-mono">
                                            @evt.StreamId.ToString()[..8]...
                                        </a>
                                    </td>
                                    <td class="px-3 py-2 text-sm text-graphite">@evt.Timestamp.ToString("HH:mm:ss")</td>
                                    <td class="px-3 py-2 text-sm text-graphite">@(evt.ActorId ?? "—")</td>
                                </tr>
                            }
                            @if (Model.Events.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="px-3 py-4 text-center text-graphite">No events found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetEventColor(string eventType)
    {
        return eventType switch
        {
            "MemoryCreated" => "border-green-500",
            "MemoryUpdated" => "border-blue-500",
            "MemoryDecayed" => "border-yellow-500",
            "MemoryReinforced" => "border-cyan-500",
            "MemoryMerged" => "border-purple-500",
            "MemoryInvalidated" => "border-red-500",
            "MemorySplit" => "border-orange-500",
            "MemoryArchived" => "border-gray-500",
            _ => "border-slate"
        };
    }
}
