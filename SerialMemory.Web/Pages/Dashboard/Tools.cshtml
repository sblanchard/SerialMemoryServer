@page "/dashboard/tools"
@model SerialMemory.Web.Pages.Dashboard.ToolsModel
@{
    ViewData["Title"] = "Tool Analytics";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">Tool Analytics</h1>
            <p class="mt-2 text-graphite">MCP tool usage statistics and lazy-MCP category breakdown.</p>
        </div>
        <div class="flex gap-2">
            <a href="/dashboard/tools?days=1" class="px-3 py-1 rounded text-sm @(Model.Days == 1 ? "bg-electric text-white" : "bg-slate text-graphite hover:text-soft-white")">Today</a>
            <a href="/dashboard/tools?days=7" class="px-3 py-1 rounded text-sm @(Model.Days == 7 ? "bg-electric text-white" : "bg-slate text-graphite hover:text-soft-white")">7d</a>
            <a href="/dashboard/tools?days=30" class="px-3 py-1 rounded text-sm @(Model.Days == 30 ? "bg-electric text-white" : "bg-slate text-graphite hover:text-soft-white")">30d</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    <!-- Stats Overview -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="card">
            <div class="text-sm font-medium text-graphite">Total Calls</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@(Model.Stats?.TotalCalls ?? 0)</div>
            <div class="text-xs text-graphite mt-1">Last @Model.Days days</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Unique Tools</div>
            <div class="mt-1 text-2xl font-semibold text-cyan">@(Model.Stats?.UniqueTools ?? 0)</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Avg Latency</div>
            <div class="mt-1 text-2xl font-semibold text-soft-white">@((Model.Stats?.AvgLatencyMs ?? 0).ToString("F0"))ms</div>
        </div>
        <div class="card">
            <div class="text-sm font-medium text-graphite">Error Rate</div>
            <div class="mt-1 text-2xl font-semibold @(Model.Stats?.ErrorRatePct > 5 ? "text-red-400" : "text-green-400")">
                @(Model.Stats?.ErrorRatePct ?? 0)%
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
        <!-- Category Breakdown -->
        <div>
            <h2 class="text-xl font-semibold text-soft-white mb-4">Categories</h2>
            <div class="space-y-3">
                @{
                    var categoryColors = new Dictionary<string, string>
                    {
                        ["core"] = "bg-blue-500",
                        ["lifecycle"] = "bg-green-500",
                        ["observability"] = "bg-yellow-500",
                        ["safety"] = "bg-red-500",
                        ["export"] = "bg-purple-500",
                        ["reasoning"] = "bg-orange-500",
                        ["session"] = "bg-cyan",
                        ["admin"] = "bg-pink-500",
                        ["other"] = "bg-gray-500"
                    };
                    var maxCategoryCalls = Model.Categories.Any() ? Model.Categories.Max(c => c.Calls) : 1;
                }
                @foreach (var cat in Model.Categories)
                {
                    var colorClass = categoryColors.GetValueOrDefault(cat.Category, "bg-gray-500");
                    var widthPct = maxCategoryCalls > 0 ? (int)(cat.Calls * 100.0 / maxCategoryCalls) : 0;
                    <div class="card">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-sm font-medium text-soft-white capitalize">@cat.Category</span>
                            <span class="text-sm text-graphite">@cat.Calls calls (@cat.ToolCount tools)</span>
                        </div>
                        <div class="w-full bg-slate rounded-full h-2">
                            <div class="@colorClass h-2 rounded-full" style="width: @(widthPct)%"></div>
                        </div>
                    </div>
                }
                @if (Model.Categories.Count == 0)
                {
                    <div class="card text-center text-graphite py-6">No tool usage data yet.</div>
                }
            </div>
        </div>

        <!-- Top Tools -->
        <div>
            <h2 class="text-xl font-semibold text-soft-white mb-4">Top Tools</h2>
            <div class="space-y-2">
                @{
                    var maxCalls = Model.TopTools.Any() ? Model.TopTools.Max(t => t.Calls) : 1;
                }
                @foreach (var tool in Model.TopTools)
                {
                    var widthPct = maxCalls > 0 ? (int)(tool.Calls * 100.0 / maxCalls) : 0;
                    var colorClass = categoryColors.GetValueOrDefault(tool.Category, "bg-gray-500");
                    <div class="card py-2 px-3">
                        <div class="flex justify-between items-center mb-1">
                            <div class="flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full @colorClass inline-block"></span>
                                <span class="text-sm font-mono text-soft-white">@tool.ToolName</span>
                            </div>
                            <div class="flex items-center gap-3 text-xs text-graphite">
                                <span>@tool.Calls calls</span>
                                <span>@((tool.AvgLatencyMs ?? 0).ToString("F0"))ms</span>
                                @if (tool.Errors > 0)
                                {
                                    <span class="text-red-400">@tool.Errors err</span>
                                }
                            </div>
                        </div>
                        <div class="w-full bg-slate rounded-full h-1.5">
                            <div class="@colorClass h-1.5 rounded-full" style="width: @(widthPct)%"></div>
                        </div>
                    </div>
                }
                @if (Model.TopTools.Count == 0)
                {
                    <div class="card text-center text-graphite py-6">No tool usage data yet.</div>
                }
            </div>
        </div>
    </div>

    <!-- Recent Tool Calls -->
    <h2 class="text-xl font-semibold text-soft-white mb-4">Recent Tool Calls</h2>
    <div class="card">
        @if (Model.RecentCalls.Count == 0)
        {
            <div class="text-center text-graphite py-8">No recent tool calls.</div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-graphite border-b border-slate">
                            <th class="pb-2">Tool</th>
                            <th class="pb-2">Status</th>
                            <th class="pb-2">Latency</th>
                            <th class="pb-2">Credits</th>
                            <th class="pb-2">Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var call in Model.RecentCalls)
                        {
                            <tr class="border-b border-slate/50">
                                <td class="py-2 font-mono text-soft-white">@call.ToolName</td>
                                <td class="py-2">
                                    @if (call.Success)
                                    {
                                        <span class="px-2 py-0.5 text-xs rounded bg-green-600 text-white">OK</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 text-xs rounded bg-red-600 text-white" title="@call.ErrorMessage">FAIL</span>
                                    }
                                </td>
                                <td class="py-2 text-graphite">@(call.LatencyMs?.ToString() ?? "-")ms</td>
                                <td class="py-2 text-graphite">@call.CreditsUsed.ToString("F2")</td>
                                <td class="py-2 text-graphite">@call.CreatedAt.ToString("HH:mm:ss")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
