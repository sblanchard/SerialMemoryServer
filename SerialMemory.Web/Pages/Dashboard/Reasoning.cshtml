@page "/dashboard/reasoning"
@model SerialMemory.Web.Pages.Dashboard.ReasoningModel
@{
    ViewData["Title"] = "Reasoning Dashboard";
}

<div class="h-[calc(100vh-4rem)] flex flex-col">
    <div class="px-4 py-3 border-b border-slate">
        <div class="flex items-center justify-between">
            <div>
                <h1 class="text-2xl font-bold text-soft-white">Reasoning Dashboard</h1>
                <p class="text-sm text-graphite">Step-by-step reasoning analysis with DAG visualization</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 text-sm">
                    <span id="connectionStatus" class="w-2 h-2 rounded-full bg-yellow-900/300"></span>
                    <span class="text-graphite" id="connectionText">Connecting...</span>
                </div>
                <button onclick="startNewRun()" class="btn-primary px-4 py-2 rounded-lg font-medium flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                    Run Analysis
                </button>
            </div>
        </div>
    </div>

    <div class="flex-1 flex overflow-hidden">
        <!-- Left Column: Reasoning Runs List -->
        <div class="w-72 flex-shrink-0 border-r border-slate overflow-y-auto bg-navy/50">
            <div class="p-3 border-b border-slate sticky top-0 bg-navy">
                <h2 class="text-sm font-semibold text-soft-white">Reasoning Runs</h2>
                <p class="text-xs text-graphite mt-1">Select a run to view steps</p>
            </div>
            <div class="p-2 space-y-1" id="runsList">
                @if (Model.ReasoningRuns.Count == 0)
                {
                    <div class="text-center py-8 text-graphite text-sm">
                        <svg class="w-12 h-12 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                        <p>No reasoning runs yet</p>
                        <p class="text-xs mt-1">Click "Run Analysis" to start</p>
                    </div>
                }
                else
                {
                    @foreach (var run in Model.ReasoningRuns)
                    {
                        var isSelected = Model.SelectedRunId == run.Id;
                        var statusColor = run.Status switch
                        {
                            "completed" => "bg-green-900/300",
                            "running" => "bg-cyan animate-pulse",
                            "failed" => "bg-red-500",
                            _ => "bg-slate/300"
                        };
                        <button onclick="selectRun('@run.Id')"
                                class="w-full text-left p-3 rounded-lg transition hover:bg-slate/50 @(isSelected ? "bg-cyan/10 border border-cyan/30" : "")">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-xs font-medium text-soft-white">@run.Scope</span>
                                <span class="w-2 h-2 rounded-full @statusColor"></span>
                            </div>
                            <div class="text-xs text-graphite">@run.StartedAt.ToString("MMM dd HH:mm")</div>
                            <div class="text-xs text-graphite mt-1 flex items-center gap-2">
                                <span>@run.StepCount steps</span>
                                @if (run.DurationMs.HasValue)
                                {
                                    <span>@run.DurationMs ms</span>
                                }
                            </div>
                        </button>
                    }
                }
            </div>
        </div>

        <!-- Middle Column: Step Timeline -->
        <div class="flex-1 flex flex-col overflow-hidden border-r border-slate">
            <div class="p-3 border-b border-slate bg-navy">
                <h2 class="text-sm font-semibold text-soft-white">Step Timeline</h2>
                <p class="text-xs text-graphite mt-1" id="timelineStatus">Select a run to view steps</p>
            </div>
            <div class="flex-1 overflow-y-auto p-4" id="stepTimeline">
                <div id="noRunSelected" class="text-center py-12 text-graphite">
                    <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p>Select a reasoning run from the left panel</p>
                    <p class="text-xs mt-2">or click "Run Analysis" to start a new one</p>
                </div>
                <div id="stepsContainer" class="hidden space-y-3"></div>
            </div>
        </div>

        <!-- Right Column: DAG View -->
        <div class="w-96 flex-shrink-0 flex flex-col overflow-hidden">
            <div class="p-3 border-b border-slate bg-navy">
                <h2 class="text-sm font-semibold text-soft-white">Reasoning Graph</h2>
                <p class="text-xs text-graphite mt-1">Visual DAG of reasoning steps</p>
            </div>
            <div class="flex-1 overflow-hidden" id="dagContainer">
                <svg id="dagSvg" class="w-full h-full" style="background: linear-gradient(180deg, rgba(13,17,23,1) 0%, rgba(22,27,34,1) 100%);">
                    <defs>
                        <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                            <polygon points="0 0, 10 3.5, 0 7" fill="#6ee7b7" />
                        </marker>
                    </defs>
                    <g id="dagEdges"></g>
                    <g id="dagNodes"></g>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Step Detail Modal -->
<div id="stepModal" class="fixed inset-0 bg-black/50 hidden z-50 flex items-center justify-center p-4">
    <div class="bg-navy border border-slate rounded-lg max-w-2xl w-full max-h-[80vh] overflow-hidden">
        <div class="flex items-center justify-between p-4 border-b border-slate">
            <h3 class="text-lg font-semibold text-soft-white" id="modalTitle">Step Details</h3>
            <button onclick="closeModal()" class="text-graphite hover:text-soft-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <div class="p-4 overflow-y-auto max-h-[60vh]" id="modalContent"></div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
<script>
    let connection = null;
    let isConnected = false;
    let selectedRunId = null;
    let currentSteps = [];
    let currentEdges = [];

    const apiBaseUrl = window.location.protocol + '//' + window.location.hostname + ':5000';

    // Initialize SignalR
    async function initSignalR() {
        connection = new signalR.HubConnectionBuilder()
            .withUrl(apiBaseUrl + "/hubs/live")
            .withAutomaticReconnect()
            .build();

        connection.on("reasoning.progress", (evt) => {
            console.log("Progress:", evt);
            if (evt.runId === selectedRunId || !selectedRunId) {
                addStep(evt);
            }
        });

        connection.on("reasoning.result", (evt) => {
            console.log("Result:", evt);
            updateRunStatus(evt.runId, evt.status);
            if (evt.status === "completed") {
                loadRunDetails(evt.runId);
            }
        });

        connection.onreconnecting(() => updateConnectionUI(false, "Reconnecting..."));
        connection.onreconnected(() => {
            updateConnectionUI(true, "Connected");
            subscribeToStreams();
        });

        try {
            await connection.start();
            updateConnectionUI(true, "Connected");
            await subscribeToStreams();
        } catch (err) {
            console.error("SignalR failed:", err);
            updateConnectionUI(false, "Disconnected");
        }
    }

    async function subscribeToStreams() {
        if (connection) {
            await connection.invoke("Subscribe", "reasoning.progress");
            await connection.invoke("Subscribe", "reasoning.result");
        }
    }

    function updateConnectionUI(connected, text) {
        const status = document.getElementById('connectionStatus');
        const txt = document.getElementById('connectionText');
        status.className = 'w-2 h-2 rounded-full ' + (connected ? 'bg-green-900/300' : 'bg-red-500');
        txt.textContent = text;
        isConnected = connected;
    }

    // Run management
    async function startNewRun() {
        const btn = event.target.closest('button');
        btn.disabled = true;
        btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Running...';

        try {
            const response = await fetch(apiBaseUrl + '/api/reasoning/run', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ project: null, memoryId: null, limit: 50 })
            });
            const result = await response.json();
            console.log("Started run:", result);

            // Reload runs list
            setTimeout(() => location.reload(), 1000);
        } catch (err) {
            console.error("Failed to start run:", err);
            alert("Failed to start reasoning run");
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg> Run Analysis';
        }
    }

    async function selectRun(runId) {
        selectedRunId = runId;

        // Update UI selection
        document.querySelectorAll('#runsList button').forEach(btn => {
            btn.classList.remove('bg-cyan/10', 'border', 'border-cyan/30');
        });
        event.target.closest('button')?.classList.add('bg-cyan/10', 'border', 'border-cyan/30');

        document.getElementById('noRunSelected').classList.add('hidden');
        document.getElementById('stepsContainer').classList.remove('hidden');
        document.getElementById('timelineStatus').textContent = 'Loading...';

        await loadRunDetails(runId);
    }

    async function loadRunDetails(runId) {
        try {
            const response = await fetch(apiBaseUrl + `/api/reasoning/run/${runId}`);
            const data = await response.json();

            currentSteps = data.steps || [];
            currentEdges = data.edges || [];

            document.getElementById('timelineStatus').textContent = `${currentSteps.length} steps`;

            renderSteps();
            renderDAG();
        } catch (err) {
            console.error("Failed to load run:", err);
            document.getElementById('timelineStatus').textContent = 'Failed to load';
        }
    }

    function addStep(step) {
        currentSteps.push({
            id: step.stepId,
            index: currentSteps.length + 1,
            type: 'reasoning_step',
            summary: step.summary,
            parentIds: step.parentIds || []
        });

        // Add edges
        (step.parentIds || []).forEach(parentId => {
            currentEdges.push({ from: parentId, to: step.stepId });
        });

        renderSteps();
        renderDAG();

        // Auto-scroll timeline
        const container = document.getElementById('stepsContainer');
        container.scrollTop = container.scrollHeight;
    }

    function renderSteps() {
        const container = document.getElementById('stepsContainer');
        container.innerHTML = currentSteps.map((step, idx) => {
            const typeColors = {
                'plan_start': 'bg-purple-500/20 text-purple-400 border-purple-500/30',
                'reasoning_step': 'bg-cyan/20 text-cyan border-cyan/30',
                'tool_call': 'bg-yellow-900/300/20 text-yellow-400 border-yellow-500/30',
                'reflection': 'bg-blue-900/300/20 text-blue-400 border-blue-500/30',
                'completion': 'bg-green-900/300/20 text-green-400 border-green-500/30',
                'error': 'bg-red-500/20 text-red-400 border-red-500/30'
            };
            const colors = typeColors[step.type] || 'bg-slate text-graphite border-slate';

            return `
                <div class="flex items-start gap-3 animate-fadeIn cursor-pointer hover:bg-slate/30 p-2 rounded-lg transition"
                     onclick="showStepDetail('${step.id}')">
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-cyan/20 text-cyan flex items-center justify-center text-sm font-medium">
                        ${step.index}
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="px-2 py-0.5 text-xs rounded border ${colors}">${step.type}</span>
                            ${step.durationMs ? `<span class="text-xs text-graphite">${step.durationMs}ms</span>` : ''}
                        </div>
                        <p class="text-sm text-soft-white">${step.summary || 'Processing...'}</p>
                        ${step.parentIds?.length ? `<p class="text-xs text-graphite mt-1">Parents: ${step.parentIds.join(', ').substring(0, 50)}...</p>` : ''}
                    </div>
                </div>
            `;
        }).join('');
    }

    function renderDAG() {
        const svg = document.getElementById('dagSvg');
        const nodesGroup = document.getElementById('dagNodes');
        const edgesGroup = document.getElementById('dagEdges');

        nodesGroup.innerHTML = '';
        edgesGroup.innerHTML = '';

        if (currentSteps.length === 0) return;

        const width = svg.clientWidth || 384;
        const height = svg.clientHeight || 400;
        const nodeRadius = 20;
        const levelHeight = 80;
        const startY = 50;

        // Simple layout: stack vertically
        const nodePositions = {};
        currentSteps.forEach((step, idx) => {
            const x = width / 2;
            const y = startY + idx * levelHeight;
            nodePositions[step.id] = { x, y };
        });

        // Draw edges
        currentEdges.forEach(edge => {
            const from = nodePositions[edge.from];
            const to = nodePositions[edge.to];
            if (from && to) {
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', `M${from.x},${from.y + nodeRadius} Q${from.x},${(from.y + to.y) / 2} ${to.x},${to.y - nodeRadius}`);
                path.setAttribute('stroke', '#6ee7b7');
                path.setAttribute('stroke-width', '2');
                path.setAttribute('fill', 'none');
                path.setAttribute('marker-end', 'url(#arrowhead)');
                edgesGroup.appendChild(path);
            }
        });

        // Draw nodes
        currentSteps.forEach((step, idx) => {
            const pos = nodePositions[step.id];
            const isLast = idx === currentSteps.length - 1;

            const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
            g.setAttribute('class', 'cursor-pointer');
            g.onclick = () => showStepDetail(step.id);

            // Node circle
            const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
            circle.setAttribute('cx', pos.x);
            circle.setAttribute('cy', pos.y);
            circle.setAttribute('r', nodeRadius);
            circle.setAttribute('fill', isLast ? '#22c55e' : '#0891b2');
            circle.setAttribute('stroke', isLast ? '#4ade80' : '#06b6d4');
            circle.setAttribute('stroke-width', '2');
            if (isLast) {
                circle.setAttribute('class', 'animate-pulse');
            }
            g.appendChild(circle);

            // Node number
            const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            text.setAttribute('x', pos.x);
            text.setAttribute('y', pos.y + 5);
            text.setAttribute('text-anchor', 'middle');
            text.setAttribute('fill', 'white');
            text.setAttribute('font-size', '12');
            text.setAttribute('font-weight', 'bold');
            text.textContent = step.index;
            g.appendChild(text);

            // Type label
            const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
            label.setAttribute('x', pos.x + nodeRadius + 10);
            label.setAttribute('y', pos.y + 5);
            label.setAttribute('fill', '#9ca3af');
            label.setAttribute('font-size', '11');
            label.textContent = step.type;
            g.appendChild(label);

            nodesGroup.appendChild(g);
        });
    }

    function showStepDetail(stepId) {
        const step = currentSteps.find(s => s.id === stepId);
        if (!step) return;

        document.getElementById('modalTitle').textContent = `Step ${step.index}: ${step.type}`;
        document.getElementById('modalContent').innerHTML = `
            <div class="space-y-4">
                <div>
                    <label class="text-xs text-graphite block mb-1">Summary</label>
                    <p class="text-soft-white">${step.summary || 'No summary'}</p>
                </div>
                ${step.parentIds?.length ? `
                <div>
                    <label class="text-xs text-graphite block mb-1">Parent Steps</label>
                    <p class="text-soft-white font-mono text-sm">${step.parentIds.join(', ')}</p>
                </div>
                ` : ''}
                ${step.raw ? `
                <div>
                    <label class="text-xs text-graphite block mb-1">Raw Payload</label>
                    <pre class="bg-midnight p-3 rounded text-xs text-soft-white overflow-x-auto">${JSON.stringify(JSON.parse(step.raw), null, 2)}</pre>
                </div>
                ` : ''}
            </div>
        `;
        document.getElementById('stepModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('stepModal').classList.add('hidden');
    }

    function updateRunStatus(runId, status) {
        // Update the run in the list if visible
        const runBtn = document.querySelector(`button[onclick="selectRun('${runId}')"]`);
        if (runBtn) {
            const statusDot = runBtn.querySelector('.rounded-full');
            if (statusDot) {
                statusDot.className = 'w-2 h-2 rounded-full ' + (status === 'completed' ? 'bg-green-900/300' : status === 'failed' ? 'bg-red-500' : 'bg-cyan');
            }
        }
    }

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
        initSignalR();

        // Handle escape key for modal
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
    });
</script>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fadeIn {
        animation: fadeIn 0.3s ease-out;
    }
</style>
}
