@page "/dashboard/billing"
@model SerialMemory.Web.Pages.Dashboard.BillingModel
@{
    ViewData["Title"] = "Billing";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-soft-white">Billing</h1>
        <p class="mt-2 text-graphite">Manage your subscription and payment details.</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="bg-green-900/30 border border-green-500/50 text-green-700 px-4 py-3 rounded mb-6">
            @Model.SuccessMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded mb-6">
            @Model.ErrorMessage
        </div>
    }

    @if (Model.IsSampleData)
    {
        <div class="mb-6 bg-blue-900/30 border border-blue-500/50 text-blue-300 px-4 py-3 rounded-lg">
            <div class="flex items-center">
                <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
                </svg>
                <span><strong>Sample Data:</strong> You're currently on the Free plan. Upgrade to Pro to unlock more features and credits.</span>
            </div>
        </div>
    }

    <!-- Current Plan -->
    <div class="card mb-8">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-semibold">Current Plan</h3>
                <div class="mt-1 text-3xl font-bold text-indigo-600">@Model.CurrentPlan</div>
            </div>
            @if (!string.IsNullOrEmpty(Model.StripeCustomerId))
            {
                <form method="post" asp-page-handler="Portal">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="bg-slate/50 hover:bg-slate text-soft-white px-4 py-2 rounded-md text-sm font-medium">
                        Manage Billing
                    </button>
                </form>
            }
        </div>

        @if (Model.WillCancelAtPeriodEnd)
        {
            <div class="bg-yellow-900/30 border border-yellow-500/50 text-yellow-300 px-4 py-3 rounded mb-4">
                Your subscription will be cancelled at the end of the current billing period (@Model.CurrentPeriodEnd?.ToString("MMM dd, yyyy")).
                <form method="post" asp-page-handler="Resume" class="inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="ml-2 underline">Resume subscription</button>
                </form>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <div class="text-sm font-medium text-graphite">Billing Period</div>
                <div class="mt-1 text-soft-white">
                    @Model.CurrentPeriodStart?.ToString("MMM dd") - @Model.CurrentPeriodEnd?.ToString("MMM dd, yyyy")
                </div>
            </div>
            <div>
                <div class="text-sm font-medium text-graphite">Payment Method</div>
                <div class="mt-1 text-soft-white">
                    @if (!string.IsNullOrEmpty(Model.PaymentMethodLast4))
                    {
                        <span class="capitalize">@Model.PaymentMethodBrand</span>
                        <text>ending in @Model.PaymentMethodLast4</text>
                    }
                    else
                    {
                        <text>No payment method</text>
                    }
                </div>
            </div>
            <div>
                <div class="text-sm font-medium text-graphite">Credits Included</div>
                <div class="mt-1 text-soft-white">@Model.CreditsIncluded.ToString("N0") / month</div>
            </div>
        </div>
    </div>

    <!-- Upgrade Plans -->
    @if (Model.CurrentPlan?.ToLowerInvariant() != "enterprise")
    {
        <div class="mb-8">
            <h3 class="text-lg font-semibold mb-4">Upgrade Your Plan</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @if (Model.CurrentPlan?.ToLowerInvariant() != "free")
                {
                    <div class="card border-2 @(Model.CurrentPlan?.ToLowerInvariant() == "free" ? "border-indigo-600" : "border-gray-200")">
                        <h4 class="text-lg font-semibold">Free</h4>
                        <div class="text-3xl font-bold my-4">$0<span class="text-sm font-normal text-graphite">/mo</span></div>
                        <ul class="text-sm text-graphite space-y-2 mb-6">
                            <li>100 credits/month</li>
                            <li>1,000 memories</li>
                            <li>10 req/min</li>
                        </ul>
                        @if (Model.CurrentPlan?.ToLowerInvariant() == "free")
                        {
                            <span class="block text-center py-2 bg-slate/50 text-graphite rounded-md">Current Plan</span>
                        }
                    </div>
                }

                <div class="card border-2 @(Model.CurrentPlan?.ToLowerInvariant() == "pro" ? "border-indigo-600" : "border-gray-200")">
                    @if (Model.CurrentPlan?.ToLowerInvariant() != "pro")
                    {
                        <span class="inline-block bg-indigo-100 text-indigo-800 text-xs px-2 py-1 rounded mb-2">Recommended</span>
                    }
                    <h4 class="text-lg font-semibold">Pro</h4>
                    <div class="text-3xl font-bold my-4">€19<span class="text-sm font-normal text-graphite">/mo</span></div>
                    <ul class="text-sm text-graphite space-y-2 mb-6">
                        <li>5,000 credits/month</li>
                        <li>50,000 memories</li>
                        <li>60 req/min</li>
                        <li>Credit carryover</li>
                    </ul>
                    @if (Model.CurrentPlan?.ToLowerInvariant() == "pro")
                    {
                        <span class="block text-center py-2 bg-slate/50 text-graphite rounded-md">Current Plan</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Checkout">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="pro" />
                            <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white py-2 rounded-md">
                                @(Model.CurrentPlan?.ToLowerInvariant() == "free" ? "Upgrade to Pro" : "Switch to Pro")
                            </button>
                        </form>
                    }
                </div>

                <div class="card border-2 @(Model.CurrentPlan?.ToLowerInvariant() == "pro_plus" ? "border-indigo-600" : "border-gray-200")">
                    <h4 class="text-lg font-semibold">Pro Plus</h4>
                    <div class="text-3xl font-bold my-4">€49<span class="text-sm font-normal text-graphite">/mo</span></div>
                    <ul class="text-sm text-graphite space-y-2 mb-6">
                        <li>200,000 credits/month</li>
                        <li>500,000 memories</li>
                        <li>No rate limits</li>
                        <li>Priority support</li>
                        <li>SSO</li>
                    </ul>
                    @if (Model.CurrentPlan?.ToLowerInvariant() == "pro_plus")
                    {
                        <span class="block text-center py-2 bg-slate/50 text-graphite rounded-md">Current Plan</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Checkout">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="pro_plus" />
                            <button type="submit" class="w-full bg-purple-600 hover:bg-purple-700 text-white py-2 rounded-md">
                                Upgrade to Pro Plus
                            </button>
                        </form>
                    }
                </div>

                <div class="card border-2 @(Model.CurrentPlan?.ToLowerInvariant() == "enterprise" ? "border-indigo-600" : "border-gray-200")">
                    <h4 class="text-lg font-semibold">Enterprise</h4>
                    <div class="text-3xl font-bold my-4">€299<span class="text-sm font-normal text-graphite">/mo</span></div>
                    <ul class="text-sm text-graphite space-y-2 mb-6">
                        <li>Unlimited credits</li>
                        <li>Unlimited memories</li>
                        <li>Dedicated infrastructure</li>
                        <li>24/7 premium support</li>
                        <li>Custom SLA</li>
                    </ul>
                    @if (Model.CurrentPlan?.ToLowerInvariant() == "enterprise")
                    {
                        <span class="block text-center py-2 bg-slate/50 text-graphite rounded-md">Current Plan</span>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="Checkout">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="plan" value="enterprise" />
                            <button type="submit" class="w-full bg-gray-800 hover:bg-gray-900 text-white py-2 rounded-md">
                                Upgrade to Enterprise
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Payment History -->
    <div class="card mb-8">
        <h3 class="text-lg font-semibold mb-4">Payment History</h3>
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
                <tr>
                    <th class="px-4 py-3 text-left text-xs font-medium text-graphite uppercase">Date</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-graphite uppercase">Description</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-graphite uppercase">Amount</th>
                    <th class="px-4 py-3 text-left text-xs font-medium text-graphite uppercase">Status</th>
                    <th class="px-4 py-3 text-right text-xs font-medium text-graphite uppercase">Invoice</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
                @if (Model.PaymentHistory.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="px-4 py-8 text-center text-graphite">
                            No payment history yet.
                        </td>
                    </tr>
                }
                @foreach (var payment in Model.PaymentHistory)
                {
                    <tr>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-soft-white">
                            @payment.CreatedAt.ToString("MMM dd, yyyy")
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-graphite">
                            @payment.PlanName subscription
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-sm text-soft-white">
                            $@((payment.AmountCents / 100.0).ToString("N2"))
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap">
                            @{
                                var statusClass = payment.Status switch
                                {
                                    "paid" => "bg-green-100 text-green-300",
                                    "failed" => "bg-red-100 text-red-800",
                                    "pending" => "bg-yellow-100 text-yellow-300",
                                    _ => "bg-slate/50 text-soft-white"
                                };
                            }
                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full @statusClass capitalize">
                                @payment.Status
                            </span>
                        </td>
                        <td class="px-4 py-4 whitespace-nowrap text-right text-sm">
                            @if (!string.IsNullOrEmpty(payment.InvoicePdfUrl))
                            {
                                <a href="@payment.InvoicePdfUrl" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                                    Download
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Cancel Subscription -->
    @if (!string.IsNullOrEmpty(Model.StripeSubscriptionId) && !Model.WillCancelAtPeriodEnd)
    {
        <div class="card border-red-200">
            <h3 class="text-lg font-semibold text-red-600 mb-2">Cancel Subscription</h3>
            <p class="text-graphite mb-4">
                Your subscription will remain active until the end of your current billing period.
                You'll be downgraded to the Free plan after that.
            </p>
            <form method="post" asp-page-handler="Cancel"
                onsubmit="return confirm('Are you sure you want to cancel your subscription?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-md text-sm font-medium">
                    Cancel Subscription
                </button>
            </form>
        </div>
    }
</div>
