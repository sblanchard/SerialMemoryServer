@page "/dashboard/mind"
@model SerialMemory.Web.Pages.Dashboard.MindModel
@{
    ViewData["Title"] = "Mind Health";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="mb-8 flex justify-between items-center">
        <div>
            <h1 class="text-3xl font-bold text-soft-white">Mind Health</h1>
            <p class="mt-2 text-graphite">Monitor knowledge graph coherence, drift, and cognitive health.</p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="toggleExplanation()" class="text-sm text-cyan hover:text-white transition flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                How scores work
            </button>
            <form method="post" asp-page-handler="Recalibrate">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-primary px-4 py-2 rounded-md text-sm font-medium">
                    Recalibrate
                </button>
            </form>
        </div>
    </div>

    <!-- Score Explanation Panel (Hidden by default) -->
    <div id="explanationPanel" class="hidden mb-6 card bg-midnight/50 border border-cyan/20">
        <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-lg bg-cyan/10 flex items-center justify-center">
                <svg class="w-5 h-5 text-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
            </div>
            <div class="flex-1">
                <h3 class="text-soft-white font-medium mb-2">Understanding Mind Health Scores</h3>
                <div class="grid md:grid-cols-2 gap-4 text-sm text-graphite">
                    <div>
                        <p class="font-medium text-electric mb-1">Overall Score</p>
                        <p>Weighted average: Coherence (25%) + Consistency (30%) + Reliability (25%) + Freshness (20%)</p>
                    </div>
                    <div>
                        <p class="font-medium text-cyan mb-1">Status Thresholds</p>
                        <p>Excellent: 90%+ | Healthy: 70-89% | Warning: 50-69% | Critical: &lt;50%</p>
                    </div>
                    <div>
                        <p class="font-medium text-green-400 mb-1">Improving Scores</p>
                        <p>Reinforce validated memories, resolve contradictions, archive stale data, and flag hallucinations.</p>
                    </div>
                    <div>
                        <p class="font-medium text-purple-400 mb-1">Recalibrate</p>
                        <p>Triggers full re-analysis: decay application, duplicate detection, and contradiction scanning.</p>
                    </div>
                </div>
            </div>
            <button onclick="toggleExplanation()" class="text-graphite hover:text-soft-white">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-6 bg-red-900/50 border border-red-500 text-red-200 px-4 py-3 rounded-lg">
            @Model.ErrorMessage
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="mb-6 bg-green-900/50 border border-green-500 text-green-200 px-4 py-3 rounded-lg">
            @Model.SuccessMessage
        </div>
    }

    <!-- Overall Health Score -->
    @if (Model.HealthScore != null && Model.HealthScore.Status == "NoData")
    {
        <!-- No data state - new user with no memories -->
        <div class="card mb-8">
            <div class="text-center py-8">
                <svg class="w-16 h-16 mx-auto text-graphite mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                <h3 class="text-xl font-medium text-soft-white mb-2">No Memories Yet</h3>
                <p class="text-graphite max-w-md mx-auto">
                    Start using the MCP tools to ingest memories. Once you have data, you'll see health metrics here showing coherence, consistency, and reliability scores.
                </p>
            </div>
        </div>
    }
    else if (Model.HealthScore != null)
    {
        <div class="card mb-8">
            <div class="grid grid-cols-1 md:grid-cols-6 gap-6">
                <div class="md:col-span-2 flex flex-col items-center justify-center">
                    <div class="relative">
                        <svg class="w-32 h-32 transform -rotate-90" viewBox="0 0 120 120">
                            <circle cx="60" cy="60" r="54" fill="none" stroke="#374151" stroke-width="8" />
                            <circle cx="60" cy="60" r="54" fill="none"
                                    stroke="@(Model.HealthScore.OverallScore >= 0.8 ? "#22C55E" : Model.HealthScore.OverallScore >= 0.6 ? "#FACC15" : "#EF4444")"
                                    stroke-width="8" stroke-dasharray="@((Model.HealthScore.OverallScore * 339.29).ToString("F0")) 339.29" stroke-linecap="round" />
                        </svg>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <span class="text-3xl font-bold text-soft-white">@((Model.HealthScore.OverallScore * 100).ToString("F0"))%</span>
                        </div>
                    </div>
                    <div class="mt-2 text-sm font-medium @(Model.HealthScore.Status == "Healthy" ? "text-green-400" : Model.HealthScore.Status == "Warning" ? "text-yellow-400" : "text-red-400")">
                        @Model.HealthScore.Status
                    </div>
                    <div class="text-xs text-graphite mt-1">Updated @Model.HealthScore.CalculatedAt.ToString("HH:mm")</div>
                </div>
                <div class="md:col-span-4 grid grid-cols-2 md:grid-cols-4 gap-4">
                    <!-- Coherence Score -->
                    <div class="bg-slate/30 rounded-md p-4 text-center group relative">
                        <div class="text-2xl font-semibold text-soft-white">@((Model.HealthScore.CoherenceScore * 100).ToString("F0"))%</div>
                        <div class="text-xs text-graphite mt-1 flex items-center justify-center gap-1">
                            Coherence
                            <svg class="w-3 h-3 text-graphite/60 cursor-help" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="w-full bg-slate rounded-full h-1 mt-2">
                            <div class="bg-electric h-1 rounded-full" style="width: @((Model.HealthScore.CoherenceScore * 100))%"></div>
                        </div>
                        <!-- Tooltip -->
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-midnight border border-slate rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-10 text-left">
                            <div class="text-xs text-soft-white font-medium mb-1">Coherence Score</div>
                            <div class="text-xs text-graphite">Measures how well memories relate to each other semantically. High coherence means memories form logical clusters and don't contain isolated, disconnected information.</div>
                            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 rotate-45 w-2 h-2 bg-midnight border-r border-b border-slate"></div>
                        </div>
                    </div>
                    <!-- Consistency Score -->
                    <div class="bg-slate/30 rounded-md p-4 text-center group relative">
                        <div class="text-2xl font-semibold text-soft-white">@((Model.HealthScore.ConsistencyScore * 100).ToString("F0"))%</div>
                        <div class="text-xs text-graphite mt-1 flex items-center justify-center gap-1">
                            Consistency
                            <svg class="w-3 h-3 text-graphite/60 cursor-help" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="w-full bg-slate rounded-full h-1 mt-2">
                            <div class="bg-cyan h-1 rounded-full" style="width: @((Model.HealthScore.ConsistencyScore * 100))%"></div>
                        </div>
                        <!-- Tooltip -->
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-midnight border border-slate rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-10 text-left">
                            <div class="text-xs text-soft-white font-medium mb-1">Consistency Score</div>
                            <div class="text-xs text-graphite">Measures absence of contradictions. Low score indicates conflicting information exists (e.g., "X uses PostgreSQL" vs "X uses MySQL"). Resolve contradictions to improve.</div>
                            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 rotate-45 w-2 h-2 bg-midnight border-r border-b border-slate"></div>
                        </div>
                    </div>
                    <!-- Reliability Score -->
                    <div class="bg-slate/30 rounded-md p-4 text-center group relative">
                        <div class="text-2xl font-semibold text-soft-white">@((Model.HealthScore.ReliabilityScore * 100).ToString("F0"))%</div>
                        <div class="text-xs text-graphite mt-1 flex items-center justify-center gap-1">
                            Reliability
                            <svg class="w-3 h-3 text-graphite/60 cursor-help" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="w-full bg-slate rounded-full h-1 mt-2">
                            <div class="bg-green-900/300 h-1 rounded-full" style="width: @((Model.HealthScore.ReliabilityScore * 100))%"></div>
                        </div>
                        <!-- Tooltip -->
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-midnight border border-slate rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-10 text-left">
                            <div class="text-xs text-soft-white font-medium mb-1">Reliability Score</div>
                            <div class="text-xs text-graphite">Based on average confidence and hallucination rate. High confidence memories with few flagged hallucinations indicate reliable knowledge. Validate low-confidence memories to improve.</div>
                            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 rotate-45 w-2 h-2 bg-midnight border-r border-b border-slate"></div>
                        </div>
                    </div>
                    <!-- Freshness Score -->
                    <div class="bg-slate/30 rounded-md p-4 text-center group relative">
                        <div class="text-2xl font-semibold text-soft-white">@((Model.HealthScore.FreshnessScore * 100).ToString("F0"))%</div>
                        <div class="text-xs text-graphite mt-1 flex items-center justify-center gap-1">
                            Freshness
                            <svg class="w-3 h-3 text-graphite/60 cursor-help" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <div class="w-full bg-slate rounded-full h-1 mt-2">
                            <div class="bg-purple-500 h-1 rounded-full" style="width: @((Model.HealthScore.FreshnessScore * 100))%"></div>
                        </div>
                        <!-- Tooltip -->
                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-64 p-3 bg-midnight border border-slate rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-10 text-left">
                            <div class="text-xs text-soft-white font-medium mb-1">Freshness Score</div>
                            <div class="text-xs text-graphite">Measures how recently memories have been reinforced. Old, unaccessed memories decay over time. Reinforce important memories or archive stale ones to improve freshness.</div>
                            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 rotate-45 w-2 h-2 bg-midnight border-r border-b border-slate"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Stats Overview -->
    @if (Model.Stats != null)
    {
        <div class="grid grid-cols-2 md:grid-cols-7 gap-4 mb-8">
            <div class="card group relative" title="All memories ever stored in the knowledge graph">
                <div class="text-sm font-medium text-graphite">Total Memories</div>
                <div class="mt-1 text-2xl font-semibold text-soft-white">@Model.Stats.TotalMemories.ToString("N0")</div>
            </div>
            <div class="card group relative" title="Memories currently available for retrieval (not archived/invalidated)">
                <div class="text-sm font-medium text-graphite">Active</div>
                <div class="mt-1 text-2xl font-semibold text-green-400">@Model.Stats.ActiveMemories.ToString("N0")</div>
            </div>
            <div class="card group relative" title="Memories moved to cold storage due to low access/confidence">
                <div class="text-sm font-medium text-graphite">Archived</div>
                <div class="mt-1 text-2xl font-semibold text-graphite">@Model.Stats.ArchivedMemories.ToString("N0")</div>
            </div>
            <div class="card group relative" title="Average confidence score across all active memories (0-100%)">
                <div class="text-sm font-medium text-graphite">Avg Confidence</div>
                <div class="mt-1 text-2xl font-semibold text-cyan">@((Model.Stats.AvgConfidence * 100).ToString("F0"))%</div>
            </div>
            <div class="card group relative" title="Memories flagged as potentially containing fabricated/incorrect information">
                <div class="text-sm font-medium text-graphite">Hallucinations</div>
                <div class="mt-1 text-2xl font-semibold text-purple-400">@Model.Stats.HallucinationCount</div>
            </div>
            <div class="card group relative" title="Pairs of memories with conflicting information that need resolution">
                <div class="text-sm font-medium text-graphite">Contradictions</div>
                <div class="mt-1 text-2xl font-semibold text-red-400">@Model.Stats.ContradictionCount</div>
            </div>
            <div class="card group relative" title="Alerts requiring attention (low confidence, high decay, integrity issues)">
                <div class="text-sm font-medium text-graphite">Unresolved Alerts</div>
                <div class="mt-1 text-2xl font-semibold text-yellow-400">@Model.Stats.UnresolvedAlerts</div>
            </div>
        </div>
    }

    <!-- Tabs -->
    <div class="mb-6 border-b border-slate">
        <nav class="-mb-px flex space-x-8">
            <a href="/dashboard/mind" class="tab-btn @(Model.ActiveTab == "overview" ? "border-b-2 border-electric text-electric" : "border-b-2 border-transparent text-graphite hover:text-soft-white") py-2 px-1 text-sm font-medium">
                Overview
            </a>
            <a href="/dashboard/mind?tab=alerts" class="tab-btn @(Model.ActiveTab == "alerts" ? "border-b-2 border-electric text-electric" : "border-b-2 border-transparent text-graphite hover:text-soft-white") py-2 px-1 text-sm font-medium">
                Alerts (@Model.ActiveAlerts.Count)
            </a>
            <a href="/dashboard/mind?tab=hallucinations" class="tab-btn @(Model.ActiveTab == "hallucinations" ? "border-b-2 border-electric text-electric" : "border-b-2 border-transparent text-graphite hover:text-soft-white") py-2 px-1 text-sm font-medium">
                Hallucinations (@Model.Hallucinations.Count)
            </a>
            <a href="/dashboard/mind?tab=contradictions" class="tab-btn @(Model.ActiveTab == "contradictions" ? "border-b-2 border-electric text-electric" : "border-b-2 border-transparent text-graphite hover:text-soft-white") py-2 px-1 text-sm font-medium">
                Contradictions (@Model.Contradictions.Count)
            </a>
        </nav>
    </div>

    @if (Model.ActiveTab == "overview")
    {
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
            <!-- Daily Trend -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">30-Day Health Trend</h3>
                @if (Model.DailyTrend.Count > 0)
                {
                    <div class="h-40 flex items-end gap-1">
                        @foreach (var point in Model.DailyTrend)
                        {
                            var color = point.HealthScore >= 0.8 ? "bg-green-900/300" : point.HealthScore >= 0.6 ? "bg-yellow-900/300" : "bg-red-500";
                            <div class="flex-1 @color rounded-t hover:opacity-80 transition" style="height: @((point.HealthScore * 100))%"
                                 title="@point.Date.ToString("MMM dd"): @((point.HealthScore * 100).ToString("F0"))%"></div>
                        }
                    </div>
                    <div class="flex justify-between text-xs text-graphite mt-2">
                        <span>@Model.DailyTrend.First().Date.ToString("MMM dd")</span>
                        <span>@Model.DailyTrend.Last().Date.ToString("MMM dd")</span>
                    </div>
                }
                else
                {
                    <div class="text-center text-graphite py-8">No trend data available</div>
                }
            </div>

            <!-- Drift Calibration -->
            <div class="card">
                <h3 class="text-lg font-semibold text-soft-white mb-4">Confidence Drift Calibration</h3>
                @if (Model.DriftCalibration.Count > 0)
                {
                    <div class="space-y-3">
                        @foreach (var point in Model.DriftCalibration.TakeLast(10))
                        {
                            var driftColor = Math.Abs(point.Drift) < 0.05 ? "text-green-400" : Math.Abs(point.Drift) < 0.1 ? "text-yellow-400" : "text-red-400";
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-4">
                                    <span class="text-xs text-graphite w-24">@point.Timestamp.ToString("HH:mm:ss")</span>
                                    <div class="flex gap-2">
                                        <span class="text-xs text-graphite">Expected: @((point.ExpectedConfidence * 100).ToString("F0"))%</span>
                                        <span class="text-xs text-soft-white">Actual: @((point.ActualConfidence * 100).ToString("F0"))%</span>
                                    </div>
                                </div>
                                <span class="text-sm font-mono @driftColor">@(point.Drift >= 0 ? "+" : "")@((point.Drift * 100).ToString("F1"))%</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-graphite py-8">No calibration data available</div>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "alerts")
    {
        <!-- Active Alerts -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Active Alerts</h3>
            <div class="space-y-3">
                @foreach (var alert in Model.ActiveAlerts.Where(a => !a.IsAcknowledged))
                {
                    <div class="bg-slate/30 rounded-md p-4 border-l-4 @(alert.Severity == "Critical" ? "border-red-500" : alert.Severity == "Warning" ? "border-yellow-500" : "border-blue-500")">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 text-xs rounded @(alert.Severity == "Critical" ? "bg-red-600" : alert.Severity == "Warning" ? "bg-yellow-600" : "bg-blue-600") text-white">
                                    @alert.Severity
                                </span>
                                <span class="text-sm font-medium text-soft-white">@alert.AlertType</span>
                            </div>
                            <span class="text-xs text-graphite">@alert.CreatedAt.ToString("HH:mm")</span>
                        </div>
                        <div class="text-sm text-soft-white mb-2">@alert.Message</div>
                        @if (alert.RelatedMemoryId.HasValue)
                        {
                            <a href="/dashboard/traces?id=@alert.RelatedMemoryId" class="text-xs text-electric hover:underline font-mono">
                                View related memory
                            </a>
                        }
                        <form method="post" asp-page-handler="DismissAlert" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@alert.Id" />
                            <button type="submit" class="text-xs text-graphite hover:text-soft-white">Dismiss</button>
                        </form>
                    </div>
                }
                @if (!Model.ActiveAlerts.Any(a => !a.IsAcknowledged))
                {
                    <div class="text-center text-graphite py-8">No active alerts</div>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "hallucinations")
    {
        <!-- Hallucinations -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Potential Hallucinations</h3>
            <div class="space-y-4">
                @foreach (var hal in Model.Hallucinations.Where(h => !h.IsConfirmed && !h.IsDismissed))
                {
                    <div class="bg-slate/30 rounded-md p-4 border-l-4 border-purple-500">
                        <div class="flex justify-between items-start mb-2">
                            <div class="flex items-center gap-2">
                                <span class="px-2 py-0.5 text-xs rounded bg-purple-600 text-white">
                                    @((hal.HallucinationScore * 100).ToString("F0"))% likely
                                </span>
                            </div>
                            <span class="text-xs text-graphite">@hal.FlaggedAt.ToString("g")</span>
                        </div>
                        <div class="text-xs font-mono text-graphite mb-2">@hal.MemoryId</div>
                        <div class="text-sm text-soft-white bg-slate/30 rounded p-3 mb-2">@hal.Content</div>
                        @if (!string.IsNullOrEmpty(hal.Reason))
                        {
                            <div class="text-xs text-graphite mb-3">Reason: @hal.Reason</div>
                        }
                        <div class="flex gap-2">
                            <form method="post" asp-page-handler="AcknowledgeHallucination" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="memoryId" value="@hal.MemoryId" />
                                <input type="hidden" name="confirm" value="false" />
                                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs transition">
                                    Dismiss (Keep Memory)
                                </button>
                            </form>
                            <form method="post" asp-page-handler="AcknowledgeHallucination" class="inline" onsubmit="return confirm('Confirm this is a hallucination? The memory will be invalidated.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="memoryId" value="@hal.MemoryId" />
                                <input type="hidden" name="confirm" value="true" />
                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs transition">
                                    Confirm Hallucination
                                </button>
                            </form>
                        </div>
                    </div>
                }
                @if (!Model.Hallucinations.Any(h => !h.IsConfirmed && !h.IsDismissed))
                {
                    <div class="text-center text-graphite py-8">No potential hallucinations detected</div>
                }
            </div>
        </div>
    }
    else if (Model.ActiveTab == "contradictions")
    {
        <!-- Contradictions -->
        <div class="card">
            <h3 class="text-lg font-semibold text-soft-white mb-4">Detected Contradictions</h3>
            <div class="space-y-4">
                @foreach (var con in Model.Contradictions.Where(c => !c.IsResolved))
                {
                    <div class="bg-slate/30 rounded-md p-4 border-l-4 border-red-500">
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-sm font-medium text-red-400">Contradiction Detected</span>
                            <span class="text-xs text-graphite">@con.DetectedAt.ToString("g")</span>
                        </div>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                            <div class="bg-slate/30 rounded p-3">
                                <div class="text-xs font-mono text-graphite mb-1">@con.MemoryAId.ToString()[..8]...</div>
                                <div class="text-sm text-soft-white">@con.MemoryAContent</div>
                            </div>
                            <div class="bg-slate/30 rounded p-3">
                                <div class="text-xs font-mono text-graphite mb-1">@con.MemoryBId.ToString()[..8]...</div>
                                <div class="text-sm text-soft-white">@con.MemoryBContent</div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(con.Explanation))
                        {
                            <div class="text-xs text-graphite mb-3">Analysis: @con.Explanation</div>
                        }
                        <div class="flex flex-wrap gap-2">
                            <form method="post" asp-page-handler="ResolveContradiction" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contradictionId" value="@con.Id" />
                                <input type="hidden" name="resolution" value="keepA" />
                                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs transition">
                                    Keep A
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ResolveContradiction" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contradictionId" value="@con.Id" />
                                <input type="hidden" name="resolution" value="keepB" />
                                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs transition">
                                    Keep B
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ResolveContradiction" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contradictionId" value="@con.Id" />
                                <input type="hidden" name="resolution" value="keepBoth" />
                                <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1 rounded text-xs transition">
                                    Keep Both
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ResolveContradiction" class="inline" onsubmit="return confirm('Discard both memories?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="contradictionId" value="@con.Id" />
                                <input type="hidden" name="resolution" value="discardBoth" />
                                <button type="submit" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded text-xs transition">
                                    Discard Both
                                </button>
                            </form>
                        </div>
                    </div>
                }
                @if (!Model.Contradictions.Any(c => !c.IsResolved))
                {
                    <div class="text-center text-graphite py-8">No unresolved contradictions</div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function toggleExplanation() {
        const panel = document.getElementById('explanationPanel');
        panel.classList.toggle('hidden');
    }
</script>
}
