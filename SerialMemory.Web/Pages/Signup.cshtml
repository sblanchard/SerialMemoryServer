@page
@model SignupModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full">
        <div class="text-center mb-8">
            <div class="h-1 w-16 rounded-full mx-auto mb-6" style="background: #22D3EE; box-shadow: 0 0 15px #22D3EE;"></div>
            <h2 class="text-3xl font-bold text-soft-white">
                Create your account
            </h2>
            <p class="mt-3 text-graphite">
                Already have an account?
                <a href="/login" class="text-cyan hover:underline">Sign in</a>
            </p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="mb-6 p-4 rounded-lg" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #EF4444;">
                @Model.ErrorMessage
            </div>
        }

        <div class="card">
            <form class="space-y-6" method="post">
                @Html.AntiForgeryToken()

                <div>
                    <label for="organization" class="block text-sm font-medium text-soft-white mb-2">Organization Name</label>
                    <input id="organization" name="OrganizationName" type="text" required
                        class="w-full px-4 py-3 rounded-lg text-soft-white placeholder-graphite focus:outline-none focus:ring-2 focus:ring-cyan"
                        style="background: #0B0F1A; border: 1px solid #374151;"
                        placeholder="Acme Corp" asp-for="OrganizationName">
                </div>

                <div>
                    <label for="email" class="block text-sm font-medium text-soft-white mb-2">Email Address</label>
                    <input id="email" name="Email" type="email" required
                        class="w-full px-4 py-3 rounded-lg text-soft-white placeholder-graphite focus:outline-none focus:ring-2 focus:ring-cyan"
                        style="background: #0B0F1A; border: 1px solid #374151;"
                        placeholder="you@@example.com" asp-for="Email">
                </div>

                @if (!string.IsNullOrEmpty(Model.Plan) && Model.Plan != "free")
                {
                    <input type="hidden" name="Plan" value="@Model.Plan" />
                    <div class="p-3 rounded-lg" style="background: rgba(34, 211, 238, 0.1); border: 1px solid rgba(34, 211, 238, 0.2);">
                        <span class="text-cyan text-sm">Selected plan: <strong>@Model.Plan</strong></span>
                    </div>
                }

                <button type="submit" class="btn-primary w-full py-3 rounded-xl font-semibold text-lg">
                    Create Account
                </button>

                <p class="text-center text-xs text-graphite">
                    By signing up, you agree to our
                    <a href="/terms" class="text-cyan hover:underline">Terms of Service</a>
                    and
                    <a href="/privacy" class="text-cyan hover:underline">Privacy Policy</a>.
                </p>
            </form>
        </div>

        <p class="mt-6 text-center text-sm text-graphite">
            You'll receive an API key to integrate with your AI tools.
        </p>
    </div>
</div>
