@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="gradient-bg py-28">
    <div class="max-w-6xl mx-auto px-6 text-center">
        <div class="h-1 w-24 bg-cyan rounded-full mx-auto mb-8" style="box-shadow: 0 0 15px #22D3EE;"></div>
        <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-soft-white">
            Durable Memory for <span class="gradient-text">AI Systems</span>
        </h1>
        <p class="text-graphite mt-6 text-lg md:text-xl max-w-2xl mx-auto">
            SerialMemory gives your AI systems a production-grade memory layer with
            isolation, quotas, and auditability built in.
        </p>

        <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
            <a href="/signup" class="btn-primary px-8 py-3 rounded-xl font-semibold text-lg">
                Get Started Free
            </a>
            <a href="#features" class="btn-outline px-8 py-3 rounded-xl font-semibold text-lg">
                Learn More
            </a>
        </div>

        <div class="mt-12 flex justify-center gap-6 text-sm text-graphite">
            <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                No credit card required
            </span>
            <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                100 free credits
            </span>
            <span class="flex items-center gap-2">
                <svg class="w-4 h-4 text-cyan" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                MCP-native
            </span>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="bg-midnight py-24">
    <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium border mb-4" style="background: rgba(34, 211, 238, 0.1); color: #22D3EE; border-color: rgba(34, 211, 238, 0.2);">
                Production-Ready
            </span>
            <h2 class="text-3xl md:text-4xl font-bold text-soft-white">Everything your AI needs to remember</h2>
            <p class="text-graphite mt-4 max-w-xl mx-auto">A temporal knowledge graph designed for AI agent memory with semantic search, entity tracking, and multi-tenant isolation.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x1F9E0;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">Semantic Memory</h3>
                <p class="text-graphite">Store and retrieve memories using natural language queries with vector embeddings and semantic similarity search.</p>
            </div>
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x1F517;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">Knowledge Graph</h3>
                <p class="text-graphite">Automatic entity extraction and relationship tracking creates a connected knowledge graph from your memories.</p>
            </div>
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x231B;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">Temporal Context</h3>
                <p class="text-graphite">Time-aware memory with confidence decay, reinforcement, and session tracking for accurate context retrieval.</p>
            </div>
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x1F50C;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">MCP Protocol</h3>
                <p class="text-graphite">Native Model Context Protocol support for seamless integration with Claude, Cursor, and other MCP-compatible AI tools.</p>
            </div>
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x1F512;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">Multi-Tenant</h3>
                <p class="text-graphite">Strict data isolation with Row-Level Security, API keys, and tenant-scoped quotas for secure multi-user deployments.</p>
            </div>
            <div class="card">
                <div class="text-cyan text-3xl mb-4">&#x1F4CA;</div>
                <h3 class="text-xl font-semibold text-soft-white mb-2">Usage Analytics</h3>
                <p class="text-graphite">Real-time usage tracking, billing cycles, and rate limiting with detailed audit logs and tamper-evident hash chains.</p>
            </div>
        </div>
    </div>
</section>

<!-- Code Example Section -->
<section class="bg-navy py-24">
    <div class="max-w-6xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl font-bold text-soft-white mb-4">Simple MCP Integration</h2>
                <p class="text-graphite mb-6">Connect your AI agents to SerialMemory in seconds. Our MCP server handles memory storage, retrieval, and knowledge graph operations.</p>
                <div class="space-y-4">
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgba(34, 211, 238, 0.2); color: #22D3EE;">1</div>
                        <div>
                            <div class="text-soft-white font-medium">Get your API key</div>
                            <div class="text-graphite text-sm">Sign up and generate a key in seconds</div>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgba(34, 211, 238, 0.2); color: #22D3EE;">2</div>
                        <div>
                            <div class="text-soft-white font-medium">Configure your MCP client</div>
                            <div class="text-graphite text-sm">Add SerialMemory to Claude Desktop or Cursor</div>
                        </div>
                    </div>
                    <div class="flex items-start gap-3">
                        <div class="w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold" style="background: rgba(34, 211, 238, 0.2); color: #22D3EE;">3</div>
                        <div>
                            <div class="text-soft-white font-medium">Start using memory</div>
                            <div class="text-graphite text-sm">Your AI now has persistent, searchable memory</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="rounded-xl p-6" style="background: rgba(0,0,0,0.5); border: 1px solid #374151;">
                <div class="flex items-center gap-2 mb-4">
                    <div class="w-3 h-3 rounded-full bg-red-500"></div>
                    <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                    <div class="w-3 h-3 rounded-full bg-green-500"></div>
                    <span class="text-graphite text-sm ml-2">claude_desktop_config.json</span>
                </div>
                <pre class="text-sm overflow-x-auto" style="font-family: 'JetBrains Mono', monospace;"><code class="text-cyan">{
  <span class="text-soft-white">"mcpServers"</span>: {
    <span class="text-soft-white">"serial-memory"</span>: {
      <span class="text-soft-white">"command"</span>: <span class="text-electric">"npx"</span>,
      <span class="text-soft-white">"args"</span>: [<span class="text-electric">"@@serialmemory/mcp"</span>],
      <span class="text-soft-white">"env"</span>: {
        <span class="text-soft-white">"API_KEY"</span>: <span class="text-electric">"sm_your_key_here"</span>
      }
    }
  }
}</code></pre>
            </div>
        </div>
    </div>
</section>

