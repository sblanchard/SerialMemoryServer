<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SerialMemory</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --midnight: #0B0F1A;
            --navy: #11162A;
            --electric: #3B82F6;
            --cyan: #22D3EE;
            --graphite: #6B7280;
            --slate: #374151;
            --soft-white: #E5E7EB;
            --success: #22C55E;
            --warning: #FACC15;
            --danger: #EF4444;
        }
        body { font-family: 'Inter', sans-serif; }
        .bg-midnight { background-color: var(--midnight); }
        .bg-navy { background-color: var(--navy); }
        .text-soft-white { color: var(--soft-white); }
        .text-graphite { color: var(--graphite); }
        .text-cyan { color: var(--cyan); }
        .text-electric { color: var(--electric); }
        .border-slate { border-color: var(--slate); }
        .gradient-bg { background: linear-gradient(135deg, var(--navy) 0%, var(--midnight) 50%, #1a1f3a 100%); }
        .gradient-text { background: linear-gradient(90deg, var(--electric), var(--cyan)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
        .card { background-color: var(--navy); border: 1px solid var(--slate); border-radius: 0.75rem; padding: 1.5rem; transition: all 0.3s ease; }
        .card:hover { border-color: var(--electric); box-shadow: 0 0 20px rgba(59, 130, 246, 0.15); transform: translateY(-2px); }
        .btn-primary { background: linear-gradient(90deg, var(--electric), #2563eb); color: white; transition: all 0.3s ease; }
        .btn-primary:hover { box-shadow: 0 0 20px rgba(59, 130, 246, 0.4); transform: translateY(-1px); }
        .btn-outline { border: 2px solid var(--cyan); color: var(--cyan); transition: all 0.3s ease; }
        .btn-outline:hover { background-color: var(--cyan); color: var(--midnight); }
        .glow { box-shadow: 0 0 30px rgba(34, 211, 238, 0.2); }
        .nav-link { color: var(--graphite); transition: color 0.2s ease; }
        .nav-link:hover { color: var(--soft-white); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-midnight text-soft-white">
    <nav class="bg-navy border-b border-slate">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold">
                        <span class="gradient-text">SerialMemory</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="ml-10 flex items-baseline space-x-4">
                            <a href="/dashboard" class="nav-link px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
                            <a href="/dashboard/api-keys" class="nav-link px-3 py-2 rounded-md text-sm font-medium">API Keys</a>
                            <a href="/dashboard/usage" class="nav-link px-3 py-2 rounded-md text-sm font-medium">Usage</a>
                            <a href="/dashboard/billing" class="nav-link px-3 py-2 rounded-md text-sm font-medium">Billing</a>
                        </div>
                    }
                </div>
                <div class="flex items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-graphite mr-4">@User.Identity.Name</span>
                        <a href="/logout" class="bg-slate hover:bg-gray-600 text-soft-white px-4 py-2 rounded-md text-sm font-medium transition">Logout</a>
                    }
                    else
                    {
                        <a href="/login" class="nav-link px-3 py-2 rounded-md text-sm font-medium">Login</a>
                        <a href="/signup" class="ml-4 btn-primary px-4 py-2 rounded-md text-sm font-medium">Get Started</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-navy border-t border-slate mt-auto">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <p class="text-center text-graphite text-sm">SerialMemory - Temporal Knowledge Graph Memory System</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
