<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SerialMemory</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <style>
        .gradient-bg { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
        .card { @apply bg-white rounded-lg shadow-md p-6; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="min-h-screen bg-gray-50">
    <nav class="bg-white shadow-sm border-b">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="/" class="text-xl font-bold text-indigo-600">SerialMemory</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="ml-10 flex items-baseline space-x-4">
                            <a href="/dashboard" class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Dashboard</a>
                            <a href="/dashboard/api-keys" class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">API Keys</a>
                            <a href="/dashboard/usage" class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Usage</a>
                            <a href="/dashboard/billing" class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Billing</a>
                        </div>
                    }
                </div>
                <div class="flex items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-gray-600 mr-4">@User.Identity.Name</span>
                        <a href="/logout" class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2 rounded-md text-sm font-medium">Logout</a>
                    }
                    else
                    {
                        <a href="/login" class="text-gray-600 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium">Login</a>
                        <a href="/signup" class="ml-4 bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md text-sm font-medium">Get Started</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-white border-t mt-auto">
        <div class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
            <p class="text-center text-gray-500 text-sm">SerialMemory - Temporal Knowledge Graph Memory System</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
