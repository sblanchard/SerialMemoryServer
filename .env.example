# SerialMemory Environment Configuration
# Copy this to .env and fill in your values

# Azure Communication Services (for sending emails)
SERIALMEMORY_ACS_CONNECTION=endpoint=https://your-acs-resource.communication.azure.com/;accesskey=your-access-key
SERIALMEMORY_EMAIL_SENDER=DoNotReply@your-verified-domain.com
SERIALMEMORY_BASE_URL=http://localhost:5002

# Stripe (for billing - optional in self-hosted mode)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# JWT (change in production)
JWT_SECRET=dev-secret-change-in-production-32chars

# Internal Token Key (must be same for api and web-admin)
# Generate with: openssl rand -base64 64 | tr -d '\n'
INTERNAL_TOKEN_KEY=c2VyaWFsbWVtb3J5LWRldi1pbnRlcm5hbC10b2tlbi1rZXktMjAyNC1jaGFuZ2UtaW4tcHJvZHVjdGlvbi1ub3ctcGxlYXNlLWNoYW5nZS1tZQ==
