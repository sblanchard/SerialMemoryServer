{
  "name": "@serialmemory/client",
  "version": "1.0.0",
  "description": "Official Node.js/TypeScript client SDK for SerialMemory - A temporal knowledge graph memory system",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "memory",
    "knowledge-graph",
    "ai",
    "mcp",
    "semantic-search",
    "vector-database",
    "llm",
    "context"
  ],
  "author": "SerialMemory Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/serialmemory/serialmemory-server.git"
  },
  "bugs": {
    "url": "https://github.com/serialmemory/serialmemory-server/issues"
  },
  "homepage": "https://github.com/serialmemory/serialmemory-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2",
    "vitest": "^1.0.0"
  }
}
