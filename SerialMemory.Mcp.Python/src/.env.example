# Database configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=contextdb

# ML Models
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
