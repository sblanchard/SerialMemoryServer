<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SerialMemory.Mcp</AssemblyName>
    <RootNamespace>SerialMemory.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SerialMemory.Infrastructure\SerialMemory.Infrastructure.csproj" />
    <ProjectReference Include="..\SerialMemory.ML\SerialMemory.ML.csproj" />
    <ProjectReference Include="..\SerialMemory.EventSourcing\SerialMemory.EventSourcing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MCP Server Dependencies -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />

    <!-- Database -->
    <PackageReference Include="Npgsql" Version="10.0.0" />
    <PackageReference Include="Pgvector" Version="0.3.2" />

    <!-- Legacy Redis support (optional) -->
    <PackageReference Include="StackExchange.Redis" Version="2.10.1" />
  </ItemGroup>

</Project>
